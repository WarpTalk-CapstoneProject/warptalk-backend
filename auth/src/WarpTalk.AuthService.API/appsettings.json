{
  "ConnectionStrings": {
    "AuthDb": "Host=localhost;Port=5432;Database=warptalk;Username=postgres;Password=postgres;Search Path=auth,public"
  },
  "AuthSettings": {
    "MaxFailedAttempts": 5,
    "LockoutDurationMinutes": 15,
    "DefaultRole": "user"
  },
  "PasswordHasherSettings": {
    "SaltSize": 16,
    "HashSize": 32,
    "Iterations": 100000,
    "Algorithm": "SHA512",
    "VersionPrefix": "v2"
  },
  "WorkspaceSettings": {
    "ReservedSlugs": [ "admin", "api", "system", "login", "support", "auth", "help", "docs", "settings", "profile", "billing" ]
  },
  "Jwt": {
    "Secret": "CHANGE_ME_SUPER_SECRET_KEY_MIN_32_CHARS_LONG!!",
    "Issuer": "WarpTalk.AuthService",
    "Audience": "WarpTalk",
    "AccessTokenExpiryMinutes": 30,
    "RefreshTokenExpiryDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Authentication": {
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID"
    }
  }
}

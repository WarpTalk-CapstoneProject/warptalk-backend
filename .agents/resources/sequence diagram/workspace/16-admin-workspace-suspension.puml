@startuml
title WarpTalk - Admin Workspace Suspension

autonumber
<style>
sequenceDiagram {
  participant { Margin 10 }
  box { Margin 10 }
}
</style>
skinparam maxMessageSize 150

actor "System Admin" as Admin
boundary "AdminDashboardPage" as Web
control "API Gateway" as Gateway

box "Workspace Service" #LightBlue
participant ":AdminWorkspacesController" as Controller <<boundary>>
participant ":AdminWorkspaceService" as Service <<service>>
participant ":WorkspaceRepository" as WorkspaceRepository <<control>>
database "Workspace DB" as WorkspaceDb
end box

== ADMIN WORKSPACE SUSPENSION ==

Admin -> Web : Click "Suspend Workspace"
activate Web
Web -> Gateway : POST /api/v1/admin/workspaces/{id}/suspend
activate Gateway
Gateway -> Controller : SuspendWorkspace(id)
activate Controller
Controller -> Service : SuspendWorkspaceAsync(id)
activate Service

Service -> WorkspaceRepository : GetByIdAsync(id)
activate WorkspaceRepository
WorkspaceRepository -> WorkspaceDb : SELECT * FROM Workspaces WHERE Id = id
activate WorkspaceDb
WorkspaceDb --> WorkspaceRepository : Workspace Entity
deactivate WorkspaceDb
WorkspaceRepository --> Service : Workspace Entity
deactivate WorkspaceRepository

Service -> Service : Set IsActive = false\nSet Status = "SUSPENDED"
Service -> WorkspaceRepository : Update(workspace)
activate WorkspaceRepository
Service -> WorkspaceRepository : SaveChangesAsync()
WorkspaceRepository -> WorkspaceDb : UPDATE Workspaces SET Status = 'SUSPENDED'...
activate WorkspaceDb
WorkspaceDb --> WorkspaceRepository : Saved
deactivate WorkspaceDb
WorkspaceRepository --> Service : Done
deactivate WorkspaceRepository

Service --> Controller : Result.Success()
deactivate Service
Controller --> Gateway : 200 OK
deactivate Controller
Gateway --> Web : 200 OK
deactivate Gateway
Web --> Admin : Reflect 'Suspended' status on admin table
deactivate Web
@enduml

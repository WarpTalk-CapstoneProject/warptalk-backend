@startuml
title WarpTalk - Configure Verified Workspace Domains

autonumber

<style>
sequenceDiagram {
  participant {
    Margin 10
  }
  box {
    Margin 10
  }
}
</style>

actor "Workspace Owner" as Owner
boundary "WorkspaceSettingsPage" as Web
control "API Gateway" as Gateway

box "Workspace Service" #LightBlue
participant ":WorkspaceVerifiedDomainsController" as DomainsController <<boundary>>
participant ":VerifiedDomainService" as VerifiedDomainService <<service>>
participant ":WorkspaceVerifiedDomainRepository" as DomainRepository <<control>>
database "Workspace Database" as WorkspaceDb
end box

Owner -> Web : Enter domain name (e.g. "acme.com") & click Add Domain
activate Web
Web -> Gateway : POST /api/v1/workspaces/{workspaceId}/verified-domains
activate Gateway
Gateway -> DomainsController : AddVerifiedDomain(workspaceId, request)
activate DomainsController

DomainsController -> VerifiedDomainService : AddDomainAsync(workspaceId, domainName, executingUserId)
activate VerifiedDomainService

VerifiedDomainService -> DomainRepository : ExistsAsync(domainName)
activate DomainRepository
DomainRepository -> WorkspaceDb : SELECT EXISTS(SELECT 1 FROM workspace.verified_domains WHERE domain = @domain)
activate WorkspaceDb
WorkspaceDb --> DomainRepository : false
deactivate WorkspaceDb
DomainRepository --> VerifiedDomainService : false
deactivate DomainRepository

VerifiedDomainService -> DomainRepository : AddAsync(domainEntity)
activate DomainRepository
DomainRepository -> WorkspaceDb : INSERT INTO workspace.verified_domains (id, workspace_id, domain, is_verified) VALUES (...)
activate WorkspaceDb
WorkspaceDb --> DomainRepository : success
deactivate WorkspaceDb
DomainRepository --> VerifiedDomainService : domainEntity
deactivate DomainRepository

VerifiedDomainService --> DomainsController : Result.Success(domainDto)
deactivate VerifiedDomainService

DomainsController --> Gateway : 201 Created (VerifiedDomainDto)
deactivate DomainsController
Gateway --> Web : 201 Created (VerifiedDomainDto)
deactivate Gateway
Web --> Owner : Display newly added domain & verification TXT record instructions
deactivate Web

== PHASE 2: Verify Domain Ownership via DNS Check ==

Owner -> Web : Click "Verify Domain Now"
activate Web
Web -> Gateway : POST /api/v1/workspaces/{workspaceId}/verified-domains/{domainId}/verify
activate Gateway
Gateway -> DomainsController : VerifyDomain(workspaceId, domainId)
activate DomainsController

DomainsController -> VerifiedDomainService : VerifyDomainOwnershipAsync(workspaceId, domainId)
activate VerifiedDomainService

VerifiedDomainService -> DomainRepository : GetByIdAsync(domainId)
activate DomainRepository
DomainRepository -> WorkspaceDb : SELECT * FROM workspace.verified_domains WHERE id = @domainId
activate WorkspaceDb
WorkspaceDb --> DomainRepository : domainEntity
deactivate WorkspaceDb
DomainRepository --> VerifiedDomainService : domainEntity
deactivate DomainRepository

VerifiedDomainService -> VerifiedDomainService : PerformDnsTxtRecordLookup(domainName, expectedTxtToken)

alt TXT Record Verified Successfully
  VerifiedDomainService -> DomainRepository : MarkAsVerifiedAsync(domainId)
  activate DomainRepository
  DomainRepository -> WorkspaceDb : UPDATE workspace.verified_domains SET is_verified = true, verified_at = NOW() WHERE id = @domainId
  activate WorkspaceDb
  WorkspaceDb --> DomainRepository : success
  deactivate WorkspaceDb
  DomainRepository --> VerifiedDomainService : success
  deactivate DomainRepository

  VerifiedDomainService --> DomainsController : Result.Success()
  deactivate VerifiedDomainService
  DomainsController --> Gateway : 200 OK (Domain Verified)
  deactivate DomainsController
  Gateway --> Web : 200 OK
  deactivate Gateway
  Web --> Owner : Display "Domain Verified" badge & enable auto-join policy
  deactivate Web

  note over Owner, WorkspaceDb
    BR-140-013/014/015 — this table is the ONLY source of truth for verified
    domains; a VerifiedDomains array in the workspace settings JSON must not
    take part in any policy decision (WT-179).

    Changing this list changes who may be admitted, but never rewrites anyone.
    Verifying a domain does NOT retroactively upgrade existing External members
    or pending External invitations to Internal. Revoking one does NOT downgrade
    anybody either: pending invitations the new settings would refuse stay
    PENDING and fail at accept time with a reason naming the setting that
    changed, so the Owner can revoke or re-issue them deliberately. The settings
    screen shows the affected count and addresses before saving.
  end note
else DNS TXT Record Not Found / Invalid
  VerifiedDomainService --> DomainsController : Result.Failure("DNS TXT record missing or invalid", ErrorCodes.ValidationError)
  DomainsController --> Gateway : 400 Bad Request (DNS verification failed)
  Gateway --> Web : 400 Bad Request
  Web --> Owner : Show error message "TXT record not found on DNS server. Please re-try later."
end

@enduml

@startuml
title WarpTalk - Document Lifecycle and Access

autonumber

<style>
sequenceDiagram {
  participant {
    Margin 10
  }
  box {
    Margin 10
  }
}
</style>

skinparam maxMessageSize 220

actor "Workspace Member" as Actor
boundary "Workspace Documents Page" as Web
control "API Gateway" as Gateway

box "Workspace Service" #LightBlue
participant ":WorkspaceDocumentsController" as Controller <<boundary>>
participant ":WorkspaceDocumentService" as Service <<service>>
participant ":DocumentAccessEvaluator" as AccessEvaluator <<control>>
participant ":WorkspaceDocumentRepository" as DocumentRepo <<control>>
participant ":WorkspaceDocumentAccessPolicyRepository" as PolicyRepo <<control>>
participant ":WorkspaceMemberRepository" as MemberRepo <<control>>
participant ":WorkspaceRepository" as WorkspaceRepo <<control>>
participant ":WorkspaceDocumentAuditRepository" as AuditRepo <<control>>
database "Workspace Database" as Db
end box

database "Encrypted Storage" as Storage
participant ":IWorkspaceDocumentEventPublisher" as EventPublisher <<control>>
participant ":IDocumentTextExtractor" as TextExtractor <<service>>

== LIST / SEARCH DOCUMENTS ==
Actor -> Web : Open document library and search
activate Web
Web -> Gateway : GET /api/v1/workspaces/{workspaceId}/documents?search=term
activate Gateway
Gateway -> Gateway : Authenticate user
Gateway -> Controller : Forward ListDocuments request
activate Controller
Controller -> Service : ListDocumentsAsync(workspaceId, query, userId)
activate Service

Service -> WorkspaceRepo : GetByIdAsync(workspaceId)
activate WorkspaceRepo
WorkspaceRepo -> Db : SELECT workspace by id
activate Db
Db --> WorkspaceRepo : workspace
deactivate Db
WorkspaceRepo --> Service : workspace
deactivate WorkspaceRepo

Service -> DocumentRepo : FindAsync(documents by workspace)
activate DocumentRepo
DocumentRepo -> Db : SELECT non-deleted documents
activate Db
Db --> DocumentRepo : document list
deactivate Db
DocumentRepo --> Service : document list
deactivate DocumentRepo

Service -> PolicyRepo : FindAsync(policies for workspace)
activate PolicyRepo
PolicyRepo -> Db : SELECT document access policies
activate Db
Db --> PolicyRepo : policy rows
deactivate Db
PolicyRepo --> Service : policies
deactivate PolicyRepo

Service -> Service : Filter by search and access evaluator
Service -> AccessEvaluator : EvaluateAccessAsync per document
activate AccessEvaluator
AccessEvaluator --> Service : allow / deny
deactivate AccessEvaluator

Service --> Controller : PagedResult<WorkspaceDocumentDto>
deactivate Service
Controller --> Gateway : 200 OK
deactivate Controller
Gateway --> Web : 200 OK
deactivate Gateway
Web --> Actor : Display document list
deactivate Web

== VIEW EXTRACTED TEXT ==
Actor -> Web : Open extracted text
activate Web
Web -> Gateway : GET /api/v1/workspaces/{workspaceId}/documents/{documentId}/extracted-text
activate Gateway
Gateway -> Controller : Forward GetExtractedText request
activate Controller
Controller -> Service : GetExtractedTextAsync(workspaceId, documentId, userId)
activate Service

Service -> AccessEvaluator : EvaluateAccessAsync(userId, workspaceId, documentId, "view")
activate AccessEvaluator
AccessEvaluator --> Service : access result
deactivate AccessEvaluator

alt access denied
  Service --> Controller : failure
  deactivate Service
  Controller --> Gateway : 403 Forbidden
  deactivate Controller
  Gateway --> Web : 403 Forbidden
  deactivate Gateway
  Web --> Actor : Show access denied error
  deactivate Web
else access allowed
  Service -> Storage : GetExtractedTextAsync(document)
  activate Storage
  Storage --> Service : cached extracted text / empty
  deactivate Storage

  alt cached text missing
    Service -> Storage : GetDecryptedStreamAsync(document)
    activate Storage
    Storage --> Service : decrypted stream
    deactivate Storage
    Service -> TextExtractor : ExtractTextAsync(stream)
    activate TextExtractor
    TextExtractor --> Service : extracted text
    deactivate TextExtractor
    Service -> Storage : SaveExtractedTextAsync(document, json)
    activate Storage
  end

  Service --> Controller : ExtractedTextDto
  Controller --> Gateway : 200 OK
  Gateway --> Web : 200 OK
  Web --> Actor : Render extracted text
end


== APPROVE DOCUMENT ==
Actor -> Web : Approve pending document
activate Web
Web -> Gateway : POST /api/v1/workspaces/{workspaceId}/documents/{documentId}/approve
activate Gateway
Gateway -> Controller : Forward ApproveDocument request
activate Controller
Controller -> Service : ApproveDocumentAsync(workspaceId, documentId, request, userId)
activate Service

Service -> MemberRepo : Get current member
activate MemberRepo
MemberRepo -> Db : SELECT current membership
activate Db
Db --> MemberRepo : member
deactivate Db
MemberRepo --> Service : member
deactivate MemberRepo

Service -> DocumentRepo : GetByIdAsync(documentId)
activate DocumentRepo
DocumentRepo -> Db : SELECT document row
activate Db
Db --> DocumentRepo : document
deactivate Db
DocumentRepo --> Service : document
deactivate DocumentRepo

alt approve = true
  Service -> DocumentRepo : Update status=public, ingestion pending/skipped
  activate DocumentRepo
  DocumentRepo -> Db : UPDATE document row
  activate Db
  Service -> EventPublisher : PublishDocumentUploadedAsync(...) if IsAiAllowed
  activate EventPublisher
  Service -> EventPublisher : PublishDocumentLifecycleAsync(..., Approved)
else approve = false
  Service -> DocumentRepo : Update status=rejected, ingestion skipped
  DocumentRepo -> Db : UPDATE document row
  Service -> EventPublisher : PublishDocumentLifecycleAsync(..., Rejected)
end

Service --> Controller : success
deactivate Service
Controller --> Gateway : 204 NoContent
deactivate Controller
Gateway --> Web : 204 NoContent
deactivate Gateway
Web --> Actor : Refresh document list
deactivate Web


== ARCHIVE / RESTORE / DELETE ==
Actor -> Web : Archive or delete a document
activate Web
Web -> Gateway : DELETE /api/v1/workspaces/{workspaceId}/documents/{documentId}
activate Gateway
Gateway -> Controller : Forward DeleteDocument request
activate Controller
Controller -> Service : DeleteDocumentAsync(workspaceId, documentId, userId)
activate Service

Service -> AccessEvaluator : CanManagePoliciesAsync or ownership check
activate AccessEvaluator
AccessEvaluator --> Service : access / ownership result
deactivate AccessEvaluator

alt delete action
  Service -> DocumentRepo : Update DeletedAt / DeletedBy / AiEligible=false
  DocumentRepo -> Db : UPDATE document row
  Service -> EventPublisher : PublishDocumentDeletedAsync(documentId, workspaceId)
  Service -> EventPublisher : PublishDocumentLifecycleAsync(..., deleted)
else archive action
  Service -> DocumentRepo : Update Status=archived / AiEligible=false
  DocumentRepo -> Db : UPDATE document row
  Service -> EventPublisher : PublishDocumentArchivedAsync(documentId, workspaceId)
  Service -> EventPublisher : PublishDocumentLifecycleAsync(..., archived)
end

Service --> Controller : success
deactivate Service
Controller --> Gateway : 204 NoContent
deactivate Controller
Gateway --> Web : 204 NoContent
deactivate Gateway
Web --> Actor : Refresh document list
deactivate Web


deactivate EventPublisher
deactivate DocumentRepo
deactivate Storage
deactivate Db
@enduml

@startuml
title WarpTalk - Register Invited User and Access Workspace

autonumber

<style>
sequenceDiagram {
  participant {
    Margin 10
  }
  box {
    Margin 10
  }
}
</style>

skinparam maxMessageSize 150

actor "Candidate User" as Member
boundary "InvitationPage / Workspace App" as MemberWeb
control "API Gateway" as Gateway

box "Auth Service" #LightPink
participant ":AuthController" as AuthController <<boundary>>
participant ":AuthService" as AuthService <<control>>
participant ":WorkspaceInvitationGrpcClient" as WorkspaceInvitationClient <<boundary>>
participant ":UserRepository" as UserRepository <<entity>>
participant ":UserSettingsRepository" as UserSettingsRepository <<entity>>
database "Auth Database" as AuthDb
end box

box "Workspace Service" #LightBlue
participant ":WorkspaceInvitationGrpcService" as WorkspaceInvitationGrpcService <<boundary>>
participant ":WorkspaceInvitationService" as WorkspaceInvitationService <<control>>
participant ":WorkspacesController" as WorkspacesController <<boundary>>
participant ":WorkspaceService" as WorkspaceService <<control>>
participant ":WorkspaceInvitationRepository" as WorkspaceInvitationRepository <<entity>>
participant ":WorkspaceMemberRepository" as WorkspaceMemberRepository <<entity>>
database "Workspace Database" as WorkspaceDb
end box

== Register invited user ==

Member -> MemberWeb : Submit register-invited form\n[token, fullName, password]
activate MemberWeb
MemberWeb -> Gateway : POST /api/v1/auth/register-invited
activate Gateway
Gateway -> AuthController : RegisterInvited(request)
activate AuthController
AuthController -> AuthService : RegisterInvitedAsync(request)
activate AuthService

AuthService -> WorkspaceInvitationClient : VerifyInvitationTokenAsync(token)
activate WorkspaceInvitationClient
WorkspaceInvitationClient -> WorkspaceInvitationGrpcService : gRPC VerifyInvitationToken(token)
activate WorkspaceInvitationGrpcService
WorkspaceInvitationGrpcService -> WorkspaceInvitationService : VerifyInvitationTokenInternalAsync(token)
activate WorkspaceInvitationService
WorkspaceInvitationService -> WorkspaceInvitationRepository : GetByTokenHashAsync(tokenHash)
activate WorkspaceInvitationRepository
WorkspaceInvitationRepository -> WorkspaceDb : Validate token, status and expiry
activate WorkspaceDb
WorkspaceDb --> WorkspaceInvitationRepository : Invitation validation result
deactivate WorkspaceDb
WorkspaceInvitationRepository --> WorkspaceInvitationService : Invitation
deactivate WorkspaceInvitationRepository
WorkspaceInvitationService --> WorkspaceInvitationGrpcService : VerifyInvitationInternalResponse
deactivate WorkspaceInvitationService
WorkspaceInvitationGrpcService --> WorkspaceInvitationClient : VerifyInvitationTokenResponse(IsValid=true)
deactivate WorkspaceInvitationGrpcService
WorkspaceInvitationClient --> AuthService : Invitation verified
deactivate WorkspaceInvitationClient

AuthService -> UserRepository : AddAsync(new User)
activate UserRepository
UserRepository --> AuthService : Tracked
deactivate UserRepository
AuthService -> UserSettingsRepository : AddAsync(default settings)
activate UserSettingsRepository
UserSettingsRepository --> AuthService : Tracked
deactivate UserSettingsRepository
AuthService -> AuthDb : Save user and settings
activate AuthDb
AuthDb --> AuthService : Saved
deactivate AuthDb

AuthService -> WorkspaceInvitationClient : AcceptInvitationAsync(token, userId, email)
activate WorkspaceInvitationClient
WorkspaceInvitationClient -> WorkspaceInvitationGrpcService : gRPC AcceptInvitation(token, userId, email)
activate WorkspaceInvitationGrpcService
WorkspaceInvitationGrpcService -> WorkspaceInvitationService : AcceptInvitationAsync(token, userId, email)
activate WorkspaceInvitationService
WorkspaceInvitationService -> WorkspaceInvitationRepository : GetByTokenHashAsync(tokenHash)
activate WorkspaceInvitationRepository
WorkspaceInvitationRepository -> WorkspaceDb : SELECT invitation by TokenHash
activate WorkspaceDb
WorkspaceDb --> WorkspaceInvitationRepository : Invitation
deactivate WorkspaceDb
WorkspaceInvitationRepository --> WorkspaceInvitationService : Invitation
deactivate WorkspaceInvitationRepository
WorkspaceInvitationService -> WorkspaceMemberRepository : AddAsync(new WorkspaceMember)
activate WorkspaceMemberRepository
WorkspaceMemberRepository --> WorkspaceInvitationService : Tracked
deactivate WorkspaceMemberRepository
WorkspaceInvitationService -> WorkspaceInvitationRepository : Update(invitation)\nStatus = ACCEPTED\nAcceptedAt = now
activate WorkspaceInvitationRepository
WorkspaceInvitationRepository --> WorkspaceInvitationService : Tracked
deactivate WorkspaceInvitationRepository
WorkspaceInvitationService -> WorkspaceDb : Save accepted invitation and new membership
activate WorkspaceDb
WorkspaceDb --> WorkspaceInvitationService : Saved
deactivate WorkspaceDb
WorkspaceInvitationService --> WorkspaceInvitationGrpcService : Success
deactivate WorkspaceInvitationService
WorkspaceInvitationGrpcService --> WorkspaceInvitationClient : AcceptInvitationResponse(Success=true)
deactivate WorkspaceInvitationGrpcService
WorkspaceInvitationClient --> AuthService : Invitation accepted
deactivate WorkspaceInvitationClient

AuthService -> AuthDb : Commit transaction
activate AuthDb
AuthDb --> AuthService : Committed
deactivate AuthDb
AuthService --> AuthController : AuthResponse
deactivate AuthService
AuthController --> Gateway : 200 OK
deactivate AuthController
Gateway --> MemberWeb : 200 OK
deactivate Gateway

== Access workspace ==

Member -> MemberWeb : Open workspace list
MemberWeb -> Gateway : GET /api/v1/workspaces?page=1&pageSize=10 [JWT]
activate Gateway
Gateway -> WorkspacesController : GetWorkspaces(query)
activate WorkspacesController
WorkspacesController -> WorkspaceService : GetWorkspacesAsync(query, userId)
activate WorkspaceService
WorkspaceService -> WorkspaceMemberRepository : Find active memberships for user
activate WorkspaceMemberRepository
WorkspaceMemberRepository -> WorkspaceDb : SELECT workspace memberships by UserId
activate WorkspaceDb
WorkspaceDb --> WorkspaceMemberRepository : Memberships
deactivate WorkspaceDb
WorkspaceMemberRepository --> WorkspaceService : Memberships
deactivate WorkspaceMemberRepository
WorkspaceService --> WorkspacesController : PagedResult<WorkspaceDto>
deactivate WorkspaceService
WorkspacesController --> Gateway : 200 OK
deactivate WorkspacesController
Gateway --> MemberWeb : 200 OK
deactivate Gateway
MemberWeb --> Member : Joined workspace is now accessible
deactivate MemberWeb
@enduml

@startuml
title WarpTalk - Update Workspace Member Role

autonumber

<style>
sequenceDiagram {
  participant {
    Margin 10
  }
  box {
    Margin 10
  }
}
</style>

skinparam maxMessageSize 150
skinparam dpi 140
skinparam defaultFontSize 14
skinparam titleFontSize 18
skinparam classFontSize 14
skinparam sequenceParticipantFontSize 14
skinparam sequenceMessageFontSize 13

actor "Workspace Owner" as Owner
boundary "MembersRolePage" as Web
control "API Gateway" as Gateway

box "Workspace Service" #LightBlue
participant ":WorkspaceMembersController" as WorkspaceMembersController <<boundary>>
participant ":WorkspaceMemberService" as WorkspaceMemberService <<service>>
participant ":WorkspaceMemberRepository" as WorkspaceMemberRepository <<control>>
participant ":WorkspaceRepository" as WorkspaceRepository <<control>>
participant ":AuthIdentityGrpcClient" as AuthIdentityGrpcClient <<boundary>>
participant ":OutboxWorkspaceEventPublisher" as EventPublisher <<control>>
database "Workspace Database" as WorkspaceDb
end box

box "Auth Service" #LightPink
participant ":UserServiceGrpc" as UserServiceGrpc <<boundary>>
participant ":UserDirectoryService" as UserDirectoryService <<service>>
participant ":RoleRepository" as RoleRepository <<control>>
database "Auth Database" as AuthDb
end box

Owner -> Web : Select target member & new role (Admin/Member) and click "Save Changes"
activate Web

Web -> Gateway : PUT /api/v1/workspaces/{workspaceId}/members/{userId}/role\n[ChangeMemberRoleRequest: roleName]
activate Gateway

Gateway -> Gateway : Authenticate Token & extract Owner ID

alt Token Invalid
    Gateway --> Web : 401 Unauthorized
    deactivate Gateway
    Web --> Owner : Display authentication error
else Token Valid
    Gateway -> WorkspaceMembersController : ChangeMemberRole(workspaceId, userId, request)
    activate WorkspaceMembersController

    WorkspaceMembersController -> WorkspaceMemberService : ChangeMemberRoleAsync(workspaceId, userId, roleName, executingUserId)
    activate WorkspaceMemberService

    WorkspaceMemberService -> WorkspaceRepository : GetByIdAsync(workspaceId)
    activate WorkspaceRepository
    WorkspaceRepository -> WorkspaceDb : SELECT * FROM Workspaces WHERE Id = workspaceId
    activate WorkspaceDb
    WorkspaceDb --> WorkspaceRepository : Workspace entity
    deactivate WorkspaceDb
    WorkspaceRepository --> WorkspaceMemberService : Workspace entity
    deactivate WorkspaceRepository

    alt Workspace Not Found
        WorkspaceMemberService --> WorkspaceMembersController : Failure (NotFound)
        WorkspaceMembersController --> Gateway : 404 NotFound
        Gateway --> Web : 404 NotFound
    else Workspace Exists
        WorkspaceMemberService -> WorkspaceMemberRepository : FirstOrDefaultAsync(m => m.WorkspaceId == workspaceId && m.UserId == executingUserId && m.RemovedAt == null)
        activate WorkspaceMemberRepository
        WorkspaceMemberRepository -> WorkspaceDb : SELECT * FROM WorkspaceMembers WHERE WorkspaceId = workspaceId AND UserId = executingUserId AND RemovedAt IS NULL
        activate WorkspaceDb
        WorkspaceDb --> WorkspaceMemberRepository : Executing member entity
        deactivate WorkspaceDb
        WorkspaceMemberRepository --> WorkspaceMemberService : Executing member entity
        deactivate WorkspaceMemberRepository

        WorkspaceMemberService -> AuthIdentityGrpcClient : GetRoleNameByIdAsync(executingMember.RoleId)
        activate AuthIdentityGrpcClient
        AuthIdentityGrpcClient -> UserServiceGrpc : gRPC: GetRoleById(GetRoleByIdRequest)
        activate UserServiceGrpc
        UserServiceGrpc -> UserDirectoryService : GetRoleByIdAsync(roleId)
        activate UserDirectoryService
        UserDirectoryService -> RoleRepository : GetByIdAsync(roleId)
        activate RoleRepository
        RoleRepository -> AuthDb : SELECT * FROM Roles WHERE Id = roleId
        activate AuthDb
        AuthDb --> RoleRepository : Role entity
        deactivate AuthDb
        RoleRepository --> UserDirectoryService : RoleDto
        deactivate RoleRepository
        UserDirectoryService --> UserServiceGrpc : RoleDto
        deactivate UserDirectoryService
        UserServiceGrpc --> AuthIdentityGrpcClient : GetRoleResponse (Name = "Owner")
        deactivate UserServiceGrpc
        AuthIdentityGrpcClient --> WorkspaceMemberService : "Owner"
        deactivate AuthIdentityGrpcClient

        alt Executing user is NOT Owner
            WorkspaceMemberService --> WorkspaceMembersController : Failure (Forbidden: Only Owner can change roles)
            WorkspaceMembersController --> Gateway : 403 Forbidden
            Gateway --> Web : 403 Forbidden
        else Executing user IS Owner
            WorkspaceMemberService -> WorkspaceMemberRepository : FirstOrDefaultAsync(m => m.WorkspaceId == workspaceId && m.UserId == userId && m.RemovedAt == null)
            activate WorkspaceMemberRepository
            WorkspaceMemberRepository -> WorkspaceDb : SELECT * FROM WorkspaceMembers WHERE WorkspaceId = workspaceId AND UserId = userId AND RemovedAt IS NULL
            activate WorkspaceDb
            WorkspaceDb --> WorkspaceMemberRepository : Target member entity
            deactivate WorkspaceDb
            WorkspaceMemberRepository --> WorkspaceMemberService : Target member entity
            deactivate WorkspaceMemberRepository

            WorkspaceMemberService -> AuthIdentityGrpcClient : GetRoleNameByIdAsync(targetMember.RoleId)
            activate AuthIdentityGrpcClient
            AuthIdentityGrpcClient -> UserServiceGrpc : gRPC: GetRoleById(GetRoleByIdRequest)
            activate UserServiceGrpc
            UserServiceGrpc -> UserDirectoryService : GetRoleByIdAsync(roleId)
            activate UserDirectoryService
            UserDirectoryService -> RoleRepository : GetByIdAsync(roleId)
            activate RoleRepository
            RoleRepository -> AuthDb : SELECT * FROM Roles WHERE Id = roleId
            activate AuthDb
            AuthDb --> RoleRepository : Role entity
            deactivate AuthDb
            RoleRepository --> UserDirectoryService : RoleDto
            deactivate RoleRepository
            UserDirectoryService --> UserServiceGrpc : RoleDto
            deactivate UserDirectoryService
            UserServiceGrpc --> AuthIdentityGrpcClient : GetRoleResponse (Current role name)
            deactivate UserServiceGrpc
            AuthIdentityGrpcClient --> WorkspaceMemberService : Current role name (e.g. "Member")
            deactivate AuthIdentityGrpcClient

            WorkspaceMemberService -> WorkspaceMemberService : Validate transition constraints\n- Role must be Admin or Member\n- Target user cannot be self\n- Cannot change Owner role\n- External member roles are immutable

            alt Target member is Owner, Self, External, or Role Invalid
                WorkspaceMemberService --> WorkspaceMembersController : Failure (ValidationError / Forbidden)
                WorkspaceMembersController --> Gateway : 400 BadRequest / 403 Forbidden
                Gateway --> Web : Error Response
            else Validation Passes
                WorkspaceMemberService -> AuthIdentityGrpcClient : GetRoleIdByNameAsync(roleName)
                activate AuthIdentityGrpcClient
                AuthIdentityGrpcClient -> UserServiceGrpc : gRPC: GetRoleByName(GetRoleByNameRequest)
                activate UserServiceGrpc
                UserServiceGrpc -> UserDirectoryService : GetRoleByNameAsync(roleName)
                activate UserDirectoryService
                UserDirectoryService -> RoleRepository : FirstOrDefaultAsync(r => r.Name == roleName)
                activate RoleRepository
                RoleRepository -> AuthDb : SELECT * FROM Roles WHERE Name = roleName
                activate AuthDb
                AuthDb --> RoleRepository : Role entity
                deactivate AuthDb
                RoleRepository --> UserDirectoryService : RoleDto
                deactivate RoleRepository
                UserDirectoryService --> UserServiceGrpc : RoleDto
                deactivate UserDirectoryService
                UserServiceGrpc --> AuthIdentityGrpcClient : GetRoleResponse (New Role ID)
                deactivate UserServiceGrpc
                AuthIdentityGrpcClient --> WorkspaceMemberService : New Role ID
                deactivate AuthIdentityGrpcClient

                WorkspaceMemberService -> WorkspaceMemberRepository : Update(targetMember with new RoleId)
                activate WorkspaceMemberRepository
                WorkspaceMemberRepository --> WorkspaceMemberService : Entity modified
                deactivate WorkspaceMemberRepository

                WorkspaceMemberService -> EventPublisher : PublishMemberRoleChangedAsync(...)
                activate EventPublisher
                EventPublisher --> WorkspaceMemberService : Enqueued to Outbox
                deactivate EventPublisher

                WorkspaceMemberService -> WorkspaceMemberRepository : SaveChangesAsync()
                activate WorkspaceMemberRepository
                WorkspaceMemberRepository -> WorkspaceDb : UPDATE WorkspaceMembers SET RoleId = newRoleId WHERE Id = memberId
                activate WorkspaceDb
                WorkspaceDb --> WorkspaceMemberRepository : Save Successful
                deactivate WorkspaceDb
                WorkspaceMemberRepository --> WorkspaceMemberService : Save Successful
                deactivate WorkspaceMemberRepository

                WorkspaceMemberService --> WorkspaceMembersController : Result.Success()
                deactivate WorkspaceMemberService
                WorkspaceMembersController --> Gateway : 204 NoContent
                deactivate WorkspaceMembersController
                Gateway --> Web : 204 NoContent
                deactivate Gateway
                Web --> Owner : Display success notification & update member list
                deactivate Web
            end
        end
    end
end
@enduml

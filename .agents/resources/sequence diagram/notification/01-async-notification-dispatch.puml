@startuml
title WarpTalk - Asynchronous Notification & Email Dispatch

autonumber

<style>
sequenceDiagram {
  participant {
    Margin 10
  }
  box {
    Margin 10
  }
}
</style>

queue "RabbitMQ / Redis PubSub" as MQ

box "Notification Service" #LightSalmon
participant ":NotificationConsumer" as Consumer <<boundary>>
participant ":NotificationService" as Service <<service>>
participant ":TemplateEngine" as Template <<service>>
participant ":NotificationRepository" as Repo <<control>>
database "Notification Database" as Db
end box

box "External Systems" #LightGray
participant ":MailkitSmtpAdapter" as SmtpAdapter <<boundary>>
participant "Mailbox Server (SMTP)" as SmtpServer <<external system>>
end box

== STEP 1: Consume Notification Event ==
MQ -> Consumer : Consume event (e.g. WorkspaceInviteCreated / MeetingReminderTriggered)
activate Consumer

Consumer -> Service : processNotificationAsync(eventPayload)
activate Service

== STEP 2: Render Template & Check Rules ==
Service -> Template : renderTemplate(templateId, data)
activate Template
Template --> Service : renderedHtmlBody
deactivate Template

Service -> Repo : saveNotificationLog(notification)
activate Repo
Repo -> Db : INSERT into NotificationLogs
activate Db
Db --> Repo : return logId
deactivate Db
Repo --> Service : return notificationLog
deactivate Repo

== STEP 3: Dispatch via External SMTP Adapter ==
Service -> SmtpAdapter : sendEmailAsync(toEmail, subject, renderedHtmlBody)
activate SmtpAdapter

SmtpAdapter -> SmtpServer : Deliver Email via SMTP (TLS)
activate SmtpServer
SmtpServer --> SmtpAdapter : 250 OK / Email Accepted
deactivate SmtpServer

SmtpAdapter --> Service : SendResult(Success = true)
deactivate SmtpAdapter

Service -> Repo : updateStatus(logId, Delivered)
activate Repo
Repo -> Db : UPDATE NotificationLogs SET Status = 'Delivered'
activate Db
Db --> Repo : return success
deactivate Db
Repo --> Service : status updated
deactivate Repo

Service --> Consumer : Processing Complete
deactivate Service

Consumer --> MQ : Acknowledgment (Ack)
deactivate Consumer

@enduml

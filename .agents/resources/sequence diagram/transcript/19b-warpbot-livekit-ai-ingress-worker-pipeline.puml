@startuml
title WarpTalk - WarpBot & AI Worker Pipeline Orchestration (LiveKit Ingress, STT, Translation, TTS)

autonumber

<style>
sequenceDiagram {
  participant {
    Margin 10
  }
  box {
    Margin 10
  }
}
</style>

participant "LiveKit Media Server" as LiveKit <<external system>>

box "LiveKit Ingress Worker (WarpBot)" #LightCyan
participant ":LiveKitIngressWorker" as IngressBot <<boundary>>
participant ":AudioTrackPublisher" as AudioPublisher <<service>>
end box

queue "Redis Event Stream" as Redis

box "STT Worker Service (stt_worker)" #LightGreen
participant ":STTWorkerConsumer" as STTConsumer <<boundary>>
participant ":WhisperSTTEngine" as STTEngine <<service>>
end box

box "Translation Worker Service (translation_worker)" #LightYellow
participant ":TranslationWorkerConsumer" as TransConsumer <<boundary>>
participant ":TranslatorEngine" as TransEngine <<service>>
end box

box "TTS Worker Service (tts_worker)" #LightPink
participant ":TTSWorkerConsumer" as TTSConsumer <<boundary>>
participant ":CartesiaTTSEngine" as TTSEngine <<service>>
end box

== STEP 1: WarpBot (LiveKit Ingress Bot) Room Join & Audio Capture ==

IngressBot -> LiveKit : Connect WebRTC bot participant & subscribe to room audio tracks
activate LiveKit
activate IngressBot

LiveKit -->> IngressBot : Stream raw audio PCM frames (Speaker track)
IngressBot -> IngressBot : Chunk audio PCM buffer into 500ms frames

IngressBot -> Redis : XADD stt:chunks { room_id, speaker_id, pcm_bytes, timestamp }
activate Redis
Redis --> IngressBot : Message ID queued
deactivate Redis

== STEP 2: Speech-to-Text Worker Processing (stt_worker) ==

Redis ->> STTConsumer : XREADGROUP stt:chunks
activate STTConsumer

STTConsumer -> STTEngine : TranscribeAsync(pcmBytes, sourceLanguage)
activate STTEngine
STTEngine -> STTEngine : Execute Faster-Whisper model inference
STTEngine --> STTConsumer : TranscriptResult (originalText, confidence)
deactivate STTEngine

STTConsumer -> Redis : XADD stt:results { room_id, speaker_id, text, confidence }
activate Redis
Redis --> STTConsumer : Message queued
deactivate Redis
STTConsumer -> Redis : XACK stt:chunks
deactivate STTConsumer

== STEP 3: Translation Worker Processing (translation_worker) ==

Redis ->> TransConsumer : XREADGROUP stt:results
activate TransConsumer

TransConsumer -> TransEngine : TranslateAsync(originalText, sourceLang, targetLang)
activate TransEngine
TransEngine -> TransEngine : Apply Glossaries & execute NLLB/OpenAI translation
TransEngine --> TransConsumer : TranslationResult (translatedText)
deactivate TransEngine

TransConsumer -> Redis : XADD translation:results { room_id, speaker_id, translated_text, target_lang }
activate Redis
Redis --> TransConsumer : Message queued
deactivate Redis
TransConsumer -> Redis : XACK stt:results
deactivate TransConsumer

== STEP 4: Text-to-Speech Synthesizer Worker Processing (tts_worker) ==

Redis ->> TTSConsumer : XREADGROUP translation:results
activate TTSConsumer

TTSConsumer -> TTSEngine : SynthesizeSpeechAsync(translatedText, voiceId)
activate TTSEngine
TTSEngine -> TTSEngine : Generate synthetic PCM audio stream (Cartesia/OpenAI)
TTSEngine --> TTSConsumer : SyntheticAudioStream (pcmBytes)
deactivate TTSEngine

TTSConsumer -> Redis : XADD tts:audio_stream { room_id, target_user_id, pcm_bytes }
activate Redis
Redis --> TTSConsumer : Message queued
deactivate Redis
TTSConsumer -> Redis : XACK translation:results
deactivate TTSConsumer

== STEP 5: WarpBot Synthetic Audio Injection into LiveKit Room ==

Redis ->> IngressBot : XREADGROUP tts:audio_stream
IngressBot -> AudioPublisher : PublishAudioFrame(pcmBytes, targetTrack)
activate AudioPublisher

AudioPublisher -> LiveKit : Publish translated WebRTC audio track into LiveKit room
LiveKit -->> IngressBot : Audio track broadcasted
deactivate AudioPublisher

IngressBot -> Redis : XACK tts:audio_stream

deactivate IngressBot
deactivate LiveKit

@enduml

@startuml
title WarpTalk - Soft Delete Expired Artifacts (Background Cron Job)

autonumber
<style>
sequenceDiagram {
  participant { Margin 10 }
  box { Margin 10 }
}
</style>
skinparam maxMessageSize 150

participant ":CronJobTimer" as Timer
box "Transcript Service" #LightBlue
participant ":ExpiredArtifactsDeleterWorker" as Worker <<boundary>>
participant ":TranscriptService" as Service <<service>>
participant ":TranscriptRepository" as Repository <<control>>
database "Transcript Database" as Db
end box

Timer -> Worker : Trigger schedule (e.g. daily at 00:00)
activate Worker
Worker -> Service : SoftDeleteExpiredArtifactsAsync()
activate Service

Service -> Repository : GetExpiredArtifactIdsAsync(DateTime.UtcNow)
activate Repository
Repository -> Db : SELECT Id FROM Artifacts WHERE ExpireAt < UtcNow AND IsDeleted = false
activate Db
Db --> Repository : Expired IDs List
deactivate Db
Repository --> Service : Expired IDs List
deactivate Repository

loop For each expired artifact ID
    Service -> Repository : SoftDeleteArtifactAsync(id)
    activate Repository
    Repository -> Db : UPDATE Artifacts SET IsDeleted = true, DeletedAt = UtcNow WHERE Id = id
    activate Db
    Db --> Repository : Done
    deactivate Db
    Repository --> Service : Success
    deactivate Repository
end

Service --> Worker : Success
deactivate Service
Worker --> Timer : Finished
deactivate Worker
@enduml

@startuml
title WarpTalk - Background Member Suspension Check

autonumber

<style>
sequenceDiagram {
  participant {
    Margin 10
  }
  box {
    Margin 10
  }
}
</style>

skinparam maxMessageSize 150

queue "RabbitMQ Event Bus" as Bus

box "Auth Service" #LightPink
participant ":ProfileService" as ProfileService <<service>>
participant ":UserRepository" as UserRepository <<control>>
participant ":WorkspaceService\nGrpcClient" as WorkspaceServiceGrpcClient <<boundary>>
database "Auth Database" as AuthDb
end box

box "Workspace Service" #LightBlue
participant ":WorkspaceServiceGrpc" as WorkspaceServiceGrpc <<boundary>>
participant ":WorkspaceMemberRepository" as WorkspaceMemberRepository <<control>>
database "Workspace Database" as WorkspaceDb
end box

== BACKGROUND USER SUSPENSION CHECK ==

[-> Bus : MemberRemovedEvent (WorkspaceId, UserId)
Bus ->> ProfileService ++ : Consume MemberRemovedEvent (WorkspaceId, UserId)

ProfileService -> WorkspaceServiceGrpcClient : GetActiveWorkspacesCount(userId)
activate WorkspaceServiceGrpcClient
WorkspaceServiceGrpcClient -> WorkspaceServiceGrpc : gRPC: GetActiveWorkspacesCount(userId)
activate WorkspaceServiceGrpc
WorkspaceServiceGrpc -> WorkspaceMemberRepository : GetActiveWorkspacesCountAsync(userId)
activate WorkspaceMemberRepository
WorkspaceMemberRepository -> WorkspaceDb : SELECT COUNT(*) FROM WorkspaceMembers WHERE UserId = userId AND IsActive = true
activate WorkspaceDb
WorkspaceDb --> WorkspaceMemberRepository : Count
deactivate WorkspaceDb
WorkspaceMemberRepository --> WorkspaceServiceGrpc : Count
deactivate WorkspaceMemberRepository
WorkspaceServiceGrpc --> WorkspaceServiceGrpcClient : Count
deactivate WorkspaceServiceGrpc
WorkspaceServiceGrpcClient --> ProfileService : Count
deactivate WorkspaceServiceGrpcClient

alt Count > 0
    ProfileService -> ProfileService : Keep user status active (User still belongs to other workspaces)
    activate ProfileService
else Count == 0
    ProfileService -> UserRepository : UpdateUserStatus(userId, SUSPENDED_NO_ACTIVE_WORKSPACE)
    activate UserRepository
    UserRepository -> AuthDb : UPDATE Users SET Status = 'SUSPENDED_NO_ACTIVE_WORKSPACE' WHERE Id = userId
    activate AuthDb
    AuthDb --> UserRepository : Saved
    deactivate AuthDb
    UserRepository --> ProfileService : Saved
    deactivate UserRepository
end

ProfileService --> Bus -- : Acknowledge Event

deactivate ProfileService
@enduml

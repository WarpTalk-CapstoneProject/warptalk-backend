@startuml
title WarpTalk - Credit Exhaustion & Room Suspension

autonumber
<style>
sequenceDiagram {
  participant { Margin 10 }
  box { Margin 10 }
}
</style>
skinparam maxMessageSize 150

box "Billing Service" #LightCyan
participant ":CreditService" as Service <<service>>
participant ":RedisBillingStore" as RedisStore <<control>>
end box

queue "Redis System Stream" as Stream

box "Translation Room Service" #LightYellow
participant ":CreditsExhaustedConsumer" as Consumer <<boundary>>
participant ":TranslationRoomService" as Rooms <<service>>
end box

box "Meeting Service" #PaleGreen
participant ":MeetingHub\n(SignalR)" as Hub <<boundary>>
end box

boundary "MeetingRoomPage" as Client

[-> Service : Tick: Check balance (Balance <= 0)
activate Service
Service -> RedisStore : SetWorkspaceSuspended(workspaceId, true)
activate RedisStore
RedisStore --> Service : Cached
deactivate RedisStore

Service -> Stream : Publish 'CreditsExhaustedEvent'
activate Stream
deactivate Service

Stream -> Consumer : Consume event
activate Consumer
Consumer -> Rooms : DowngradeRoomToTextOnlyAsync(roomId)
activate Rooms
Rooms -> Rooms : Downgrade room status to 'TextOnly'
Rooms -> Hub : SignalR: BroadcastRoomStatus('TextOnlyFallback')
activate Hub
Hub -> Client : SignalR: Broadcast 'CreditsExhausted' status
activate Client
Client -> Client : Disable TTS/Voice Cloning audio engine
Client --> Client : Show alert: "Service downgraded to text subtitles"
deactivate Client
Hub --> Rooms : Done
deactivate Hub
Rooms --> Consumer : Done
deactivate Rooms
Consumer -> Stream : Acknowledge
deactivate Consumer
deactivate Stream
@enduml

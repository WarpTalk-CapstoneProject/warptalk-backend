@startuml
title 3.3 Meeting Module Class Diagram (Report 4 Embedded Version)

top to bottom direction
hide circle

skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam dpi 140
skinparam titleFontSize 18
skinparam packageFontSize 16
skinparam classFontSize 14
skinparam classAttributeFontSize 12
skinparam ArrowFontSize 11
skinparam nodesep 28
skinparam ranksep 36
skinparam packageTitleAlignment left
skinparam packageStyle rectangle
skinparam packageBackgroundColor White
skinparam packageBorderColor Black
skinparam classBackgroundColor White
skinparam classBorderColor Black
skinparam ArrowColor Black

package "API Layer" as ApiLayer {
  class MeetingRoomsController <<boundary>> {
    - meetingRoomService: IMeetingRoomService
    --
    + CreateRoom(request: CreateRoomRequest): Task<Result>
    + LockRoom(roomId: Guid): Task<Result>
    + EndSession(roomId: Guid): Task<Result>
  }

  class MeetingChatController <<boundary>> {
    - meetingChatService: IMeetingChatService
    --
    + SendMessage(roomId: Guid, request: SendChatMessageRequest): Task<Result>
    + GetChatHistory(roomId: Guid): Task<Result>
    + TranslateMessage(roomId: Guid, messageId: Guid): Task<Result>
  }

  class MeetingHub <<boundary>> {
    - meetingChatService: IMeetingChatService
    --
    + BroadcastRoomStatusAsync(roomId: Guid, status: String): Task
    + BroadcastChatMessageAsync(roomId: Guid, message: ChatMessageDto): Task
  }

  MeetingRoomsController -[hidden]right- MeetingChatController
  MeetingChatController -[hidden]right- MeetingHub
}

package "Application Layer" as ApplicationLayer {
  class MeetingRoomService <<control>> {
    - meetingRoomRepository: IMeetingRoomRepository
    - liveKitTokenService: ILiveKitTokenService
    - unitOfWork: IUnitOfWork
    --
    + CreateMeetingRoomAsync(translationRoomId: Guid, hostId: Guid): Task<Result>
    + LockRoomAsync(roomId: Guid, hostId: Guid): Task<Result>
    + EndSessionAsync(roomId: Guid, hostId: Guid): Task<Result>
  }

  class MeetingChatService <<control>> {
    - chatMessageRepository: IMeetingChatMessageRepository
    - meetingHub: MeetingHub
    - unitOfWork: IUnitOfWork
    --
    + SendMessageAsync(roomId: Guid, senderId: Guid, text: String): Task<Result>
    + TranslateMessageAsync(messageId: Guid, targetLanguage: String): Task<Result>
  }

  class LiveKitTokenService <<control>> {
    - liveKitServerAdapter: ILiveKitServerAdapter
    --
    + GenerateJoinTokenAsync(roomId: Guid, userId: Guid, name: String): Task<String>
  }

  MeetingRoomService -[hidden]right- MeetingChatService
  MeetingChatService -[hidden]right- LiveKitTokenService
}

package "Infrastructure Layer" as InfrastructureLayer {
  class MeetingDbContext <<control>> {
    + MeetingRooms: DbSet<MeetingRoom>
    + RtcStreamParticipants: DbSet<RtcStreamParticipant>
    + MeetingTracks: DbSet<MeetingTrack>
    + MeetingChatMessages: DbSet<MeetingChatMessage>
    + MeetingChatTranslations: DbSet<MeetingChatTranslation>
    --
    + SaveChangesAsync(): Task<Int>
  }

  class UnitOfWork <<control>> {
    - dbContext: MeetingDbContext
    --
    + SaveChangesAsync(): Task<Int>
    + BeginTransactionAsync(): Task
    + CommitTransactionAsync(): Task
  }

  class MeetingRoomRepository <<control>> {
    - dbContext: MeetingDbContext
    --
    + GetByIdAsync(id: Guid): Task<MeetingRoom>
    + GetActiveByTranslationRoomIdAsync(roomId: Guid): Task<MeetingRoom>
    + AddAsync(room: MeetingRoom): Task
  }

  class RtcStreamParticipantRepository <<control>> {
    - dbContext: MeetingDbContext
    --
    + GetActiveParticipantsByRoomIdAsync(roomId: Guid): Task<List<RtcStreamParticipant>>
    + AddAsync(participant: RtcStreamParticipant): Task
  }

  class MeetingChatMessageRepository <<control>> {
    - dbContext: MeetingDbContext
    --
    + GetByRoomIdAsync(roomId: Guid, limit: Int): Task<List<MeetingChatMessage>>
    + AddAsync(message: MeetingChatMessage): Task
  }

  class LiveKitServerAdapter <<control>> {
    - liveKitOptions: LiveKitOptions
    --
    + CreateRoomAsync(roomName: String): Task
    + IssueTokenAsync(roomName: String, identity: String): Task<String>
  }

  MeetingRoomRepository -[hidden]right- RtcStreamParticipantRepository
  RtcStreamParticipantRepository -[hidden]right- MeetingChatMessageRepository
  MeetingChatMessageRepository -[hidden]right- LiveKitServerAdapter
  MeetingDbContext -[hidden]right- UnitOfWork
  MeetingRoomRepository -[hidden]down- MeetingDbContext
}

package "Domain Layer" as DomainLayer {
  class MeetingRoom <<entity>> {
    - Id: Guid
    - TranslationRoomId: Guid
    - ProviderRoomName: String
    - ActiveHostId: Guid
    - Status: String
    - IsLocked: Boolean
    - MuteOnEntry: Boolean
    - CreatedAt: DateTime
    --
  }

  class RtcStreamParticipant <<entity>> {
    - Id: Guid
    - MeetingRoomId: Guid
    - UserId: Guid
    - ProviderIdentity: String
    - DisplayName: String
    - IsActive: Boolean
    - JoinedAt: DateTime
    --
  }

  class MeetingTrack <<entity>> {
    - Id: Guid
    - MeetingParticipantId: Guid
    - ProviderTrackId: String
    - MediaType: String
    - IsMuted: Boolean
    - IsActive: Boolean
    --
  }

  class MeetingChatMessage <<entity>> {
    - Id: Guid
    - MeetingRoomId: Guid
    - WorkspaceId: Guid
    - SenderUserId: Guid
    - SenderDisplayName: String
    - OriginalText: String
    - OriginalLanguage: String
    - SentAt: DateTime
    --
  }

  class MeetingChatTranslation <<entity>> {
    - Id: Guid
    - MessageId: Guid
    - SourceLanguage: String
    - TargetLanguage: String
    - TranslatedText: String
    --
  }

  MeetingRoom -[hidden]right- RtcStreamParticipant
  RtcStreamParticipant -[hidden]right- MeetingTrack
  MeetingTrack -[hidden]right- MeetingChatMessage
  MeetingChatMessage -[hidden]right- MeetingChatTranslation
}

package "External Systems" as ExternalSystems {
  class LiveKitServer <<external system>> {
    - endpoint: String
    --
    + CreateRoomAsync(roomName: String): Task
    + IssueToken(roomName: String, identity: String): String
  }
}

MeetingRoomsController --> MeetingRoomService
MeetingChatController --> MeetingChatService
MeetingHub --> MeetingChatService

MeetingRoomService ..> MeetingRoomRepository
MeetingRoomService ..> LiveKitTokenService
MeetingRoomService ..> UnitOfWork

MeetingChatService ..> MeetingChatMessageRepository
MeetingChatService ..> MeetingHub
MeetingChatService ..> UnitOfWork

LiveKitTokenService ..> LiveKitServerAdapter
LiveKitServerAdapter ..> LiveKitServer

MeetingRoomRepository ..> MeetingDbContext
RtcStreamParticipantRepository ..> MeetingDbContext
MeetingChatMessageRepository ..> MeetingDbContext
UnitOfWork ..> MeetingDbContext

MeetingRoomRepository ..> MeetingRoom : persists
RtcStreamParticipantRepository ..> RtcStreamParticipant : persists
MeetingChatMessageRepository ..> MeetingChatMessage : persists

MeetingRoom *-- "0..*" RtcStreamParticipant
RtcStreamParticipant *-- "0..*" MeetingTrack
MeetingRoom *-- "0..*" MeetingChatMessage
MeetingChatMessage *-- "0..*" MeetingChatTranslation

@enduml

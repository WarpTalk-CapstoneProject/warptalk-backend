@startuml
title 3.1 Auth Module Class Diagram (Report 4 Embedded Version)

top to bottom direction
hide circle

skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam dpi 140
skinparam titleFontSize 18
skinparam packageFontSize 16
skinparam classFontSize 14
skinparam classAttributeFontSize 12
skinparam ArrowFontSize 11
skinparam nodesep 42
skinparam ranksep 48
skinparam packageTitleAlignment left
skinparam packageStyle rectangle
skinparam packageBackgroundColor White
skinparam packageBorderColor Black
skinparam classBackgroundColor White
skinparam classBorderColor Black
skinparam ArrowColor Black

package "API Layer" as ApiLayer {
  class AuthController <<boundary>> {
    - authService: IAuthService
    --
    + Register(request: RegisterRequest): Task<Result>
    + Login(request: LoginRequest): Task<Result>
    + VerifyEmail(token: String): Task<Result>
    + ResetPassword(request: ResetPasswordRequest): Task<Result>
  }

  class GoogleAuthController <<boundary>> {
    - googleAuthService: IGoogleAuthService
    --
    + GoogleLogin(request: GoogleLoginRequest): Task<Result>
    + LinkGoogle(request: LinkGoogleRequest): Task<Result>
  }

  class TokenController <<boundary>> {
    - tokenService: ITokenService
    --
    + Refresh(request: RefreshTokenRequest): Task<Result>
    + Logout(request: LogoutRequest): Task<Result>
  }

  AuthController -[hidden]right- GoogleAuthController
  GoogleAuthController -[hidden]right- TokenController
}

package "Application Layer" as ApplicationLayer {
  class AuthService <<control>> {
    - userRepository: IUserRepository
    - passwordHasher: IPasswordHasher
    - tokenService: ITokenService
    - unitOfWork: IUnitOfWork
    --
    + RegisterAsync(request: RegisterRequest): Task<Result>
    + LoginAsync(request: LoginRequest): Task<Result>
    + VerifyEmailAsync(token: String): Task<Result>
  }

  class GoogleAuthService <<control>> {
    - userRepository: IUserRepository
    - tokenService: ITokenService
    - unitOfWork: IUnitOfWork
    --
    + GoogleLoginAsync(idToken: String): Task<Result>
    + LinkGoogleAsync(userId: Guid, idToken: String): Task<Result>
  }

  class TokenService <<control>> {
    - refreshTokenRepository: IRefreshTokenRepository
    - tokenGenerator: IJwtTokenGenerator
    - unitOfWork: IUnitOfWork
    --
    + RefreshTokenAsync(refreshToken: String): Task<Result>
    + LogoutAsync(userId: Guid, refreshToken: String): Task<Result>
  }

  AuthService -[hidden]right- GoogleAuthService
  GoogleAuthService -[hidden]right- TokenService
}

package "Infrastructure Layer" as InfrastructureLayer {
  class AuthDbContext <<control>> {
    + Users: DbSet<User>
    + UserSettings: DbSet<UserSetting>
    + Roles: DbSet<Role>
    + Permissions: DbSet<Permission>
    + RefreshTokens: DbSet<RefreshToken>
    + VoiceProfiles: DbSet<VoiceProfile>
    --
    + SaveChangesAsync(): Task<Int>
  }

  class UnitOfWork <<control>> {
    - dbContext: AuthDbContext
    --
    + SaveChangesAsync(): Task<Int>
    + BeginTransactionAsync(): Task
    + CommitTransactionAsync(): Task
  }

  class UserRepository <<control>> {
    - dbContext: AuthDbContext
    --
    + GetByEmailAsync(email: String): Task<User>
    + GetByIdWithRolesAsync(id: Guid): Task<User>
    + AddAsync(user: User): Task
  }

  class RefreshTokenRepository <<control>> {
    - dbContext: AuthDbContext
    --
    + GetByTokenHashAsync(hash: String): Task<RefreshToken>
    + AddAsync(token: RefreshToken): Task
    + RevokeFamilyAsync(familyId: Guid): Task
  }

  class PasswordHasher <<control>> {
    --
    + HashPassword(password: String): String
    + VerifyPassword(password: String, hash: String): Boolean
  }

  class JwtTokenGenerator <<control>> {
    - jwtOptions: JwtOptions
    --
    + GenerateAccessToken(user: User, roles: List<String>): String
    + GenerateRefreshToken(): String
  }

  UserRepository -[hidden]right- RefreshTokenRepository
  RefreshTokenRepository -[hidden]right- PasswordHasher
  PasswordHasher -[hidden]right- JwtTokenGenerator
  AuthDbContext -[hidden]right- UnitOfWork
  UserRepository -[hidden]down- AuthDbContext
}

package "Domain Layer" as DomainLayer {
  class User <<entity>> {
    - Id: Guid
    - Email: String
    - PasswordHash: String
    - FullName: String
    - PreferredLanguage: String
    - IsActive: Boolean
    - EmailVerifiedAt: DateTime?
    - GoogleId: String
    --
  }

  class UserSetting <<entity>> {
    - Id: Guid
    - UserId: Guid
    - DefaultSpeakLanguage: String
    - DefaultListenLanguage: String
    - VoiceCloneEnabled: Boolean
    - Theme: String
    --
  }

  class Role <<entity>> {
    - Id: Guid
    - Name: String
    - Description: String
    - IsSystem: Boolean
    --
  }

  class Permission <<entity>> {
    - Id: Guid
    - Code: String
    - Description: String
    - GroupName: String
    --
  }

  class RefreshToken <<entity>> {
    - Id: Guid
    - UserId: Guid
    - FamilyId: Guid
    - TokenHash: String
    - ExpiresAt: DateTime
    - RevokedAt: DateTime?
    --
  }

  class VoiceProfile <<entity>> {
    - Id: Guid
    - UserId: Guid
    - DisplayName: String
    - Provider: String
    - Status: String
    --
  }

  User -[hidden]right- Role
  Role -[hidden]right- Permission
  User -[hidden]down- UserSetting
  UserSetting -[hidden]right- RefreshToken
  RefreshToken -[hidden]right- VoiceProfile
}

package "External Systems" as ExternalSystems {
  class GoogleOAuthApi <<external system>> {
    --
    + ValidateIdTokenAsync(idToken: String): Task<GoogleUserPayload>
  }
}

AuthController --> AuthService
GoogleAuthController --> GoogleAuthService
TokenController --> TokenService

AuthService ..> UserRepository
AuthService ..> PasswordHasher
AuthService ..> TokenService
AuthService ..> UnitOfWork

GoogleAuthService ..> UserRepository
GoogleAuthService ..> TokenService
GoogleAuthService ..> GoogleOAuthApi

TokenService ..> RefreshTokenRepository
TokenService ..> JwtTokenGenerator
TokenService ..> UnitOfWork

UserRepository ..> AuthDbContext
RefreshTokenRepository ..> AuthDbContext
UnitOfWork ..> AuthDbContext

UserRepository ..> User : persists
RefreshTokenRepository ..> RefreshToken : persists

User *-- "0..*" UserSetting
User *-- "0..*" Role
User *-- "0..*" RefreshToken
User *-- "0..*" VoiceProfile
Role *-- "0..*" Permission

@enduml

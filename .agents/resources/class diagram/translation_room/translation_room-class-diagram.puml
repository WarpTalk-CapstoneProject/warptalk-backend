@startuml
title 3.4 Translation Room Module Class Diagram (Report 4 Embedded Version)

top to bottom direction
hide circle

skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam dpi 140
skinparam titleFontSize 18
skinparam packageFontSize 16
skinparam classFontSize 14
skinparam classAttributeFontSize 12
skinparam ArrowFontSize 11
skinparam nodesep 28
skinparam ranksep 36
skinparam packageTitleAlignment left
skinparam packageStyle rectangle
skinparam packageBackgroundColor White
skinparam packageBorderColor Black
skinparam classBackgroundColor White
skinparam classBorderColor Black
skinparam ArrowColor Black

package "API Layer" as ApiLayer {
  class TranslationRoomsController <<boundary>> {
    - roomService: ITranslationRoomService
    --
    + CreateTranslationRoom(request: CreateTranslationRoomRequest): Task<Result>
    + StartRoom(roomId: Guid): Task<Result>
    + JoinByLink(code: String): Task<Result>
    + HandoffHost(roomId: Guid, targetUserId: Guid): Task<Result>
  }

  class TranslationRoomParticipantsController <<boundary>> {
    - participantService: ITranslationRoomParticipantService
    --
    + JoinRoom(roomId: Guid, request: JoinRoomRequest): Task<Result>
    + UpdateParticipantSettings(roomId: Guid, request: UpdateSettingsRequest): Task<Result>
    + LeaveRoom(roomId: Guid): Task<Result>
  }

  class TranslationRoomSeriesController <<boundary>> {
    - seriesService: ITranslationRoomSeriesService
    --
    + CreateSeries(request: CreateSeriesRequest): Task<Result>
    + CancelSeries(seriesId: Guid): Task<Result>
  }

  TranslationRoomsController -[hidden]right- TranslationRoomParticipantsController
  TranslationRoomParticipantsController -[hidden]right- TranslationRoomSeriesController
}

package "Application Layer" as ApplicationLayer {
  class TranslationRoomService <<control>> {
    - roomRepository: ITranslationRoomRepository
    - participantRepository: ITranslationRoomParticipantRepository
    - unitOfWork: IUnitOfWork
    --
    + CreateTranslationRoomAsync(request: CreateTranslationRoomRequest): Task<Result>
    + StartTranslationRoomAsync(roomId: Guid, hostId: Guid): Task<Result>
    + EndTranslationRoomAsync(roomId: Guid, hostId: Guid): Task<Result>
  }

  class TranslationRoomParticipantService <<control>> {
    - participantRepository: ITranslationRoomParticipantRepository
    - roomRepository: ITranslationRoomRepository
    - unitOfWork: IUnitOfWork
    --
    + AddParticipantAsync(roomId: Guid, userId: Guid): Task<Result>
    + UpdateLanguagesAsync(participantId: Guid, speak: String, listen: String): Task<Result>
  }

  class TranslationRoomAudioRouteService <<control>> {
    - audioRouteRepository: ITranslationRoomAudioRouteRepository
    - audioRouteStateMachine: IAudioRouteStateMachine
    - unitOfWork: IUnitOfWork
    --
    + ResolveAudioRoutesAsync(roomId: Guid): Task<Result>
    + ToggleVoiceCloneAsync(participantId: Guid, enabled: Boolean): Task<Result>
  }

  TranslationRoomService -[hidden]right- TranslationRoomParticipantService
  TranslationRoomParticipantService -[hidden]right- TranslationRoomAudioRouteService
}

package "Infrastructure Layer" as InfrastructureLayer {
  class TranslationRoomDbContext <<control>> {
    + TranslationRooms: DbSet<TranslationRoom>
    + TranslationRoomSeries: DbSet<TranslationRoomSeries>
    + TranslationRoomParticipants: DbSet<TranslationRoomParticipant>
    + TranslationRoomAudioRoutes: DbSet<TranslationRoomAudioRoute>
    + TranslationRoomSessions: DbSet<TranslationRoomSession>
    --
    + SaveChangesAsync(): Task<Int>
  }

  class UnitOfWork <<control>> {
    - dbContext: TranslationRoomDbContext
    --
    + SaveChangesAsync(): Task<Int>
    + BeginTransactionAsync(): Task
    + CommitTransactionAsync(): Task
  }

  class TranslationRoomRepository <<control>> {
    - dbContext: TranslationRoomDbContext
    --
    + GetByIdAsync(id: Guid): Task<TranslationRoom>
    + GetByCodeAsync(code: String): Task<TranslationRoom>
    + AddAsync(room: TranslationRoom): Task
  }

  class TranslationRoomParticipantRepository <<control>> {
    - dbContext: TranslationRoomDbContext
    --
    + GetByRoomIdAsync(roomId: Guid): Task<List<TranslationRoomParticipant>>
    + AddAsync(participant: TranslationRoomParticipant): Task
  }

  class TranslationRoomAudioRouteRepository <<control>> {
    - dbContext: TranslationRoomDbContext
    --
    + GetCurrentRoutesAsync(roomId: Guid): Task<List<TranslationRoomAudioRoute>>
    + AddRangeAsync(routes: List<TranslationRoomAudioRoute>): Task
  }

  class AudioRouteStateMachine <<control>> {
    --
    + Transition(currentState: String, trigger: String): String
    + CanTransition(currentState: String, trigger: String): Boolean
  }

  TranslationRoomRepository -[hidden]right- TranslationRoomParticipantRepository
  TranslationRoomParticipantRepository -[hidden]right- TranslationRoomAudioRouteRepository
  TranslationRoomAudioRouteRepository -[hidden]right- AudioRouteStateMachine
  TranslationRoomDbContext -[hidden]right- UnitOfWork
  TranslationRoomRepository -[hidden]down- TranslationRoomDbContext
}

package "Domain Layer" as DomainLayer {
  class TranslationRoom <<entity>> {
    - Id: Guid
    - WorkspaceId: Guid
    - HostId: Guid
    - Title: String
    - TranslationRoomCode: String
    - Status: String
    - SourceLanguage: String
    - TargetLanguages: String
    - CreatedAt: DateTime
    --
  }

  class TranslationRoomParticipant <<entity>> {
    - Id: Guid
    - TranslationRoomId: Guid
    - UserId: Guid
    - DisplayName: String
    - Role: String
    - ListenLanguage: String
    - SpeakLanguage: String
    - Status: String
    --
  }

  class TranslationRoomAudioRoute <<entity>> {
    - Id: Guid
    - TranslationRoomId: Guid
    - SourceParticipantId: Guid
    - TargetParticipantId: Guid
    - SourceLanguage: String
    - TargetLanguage: String
    - IsCurrent: Boolean
    --
  }

  class TranslationRoomSeries <<entity>> {
    - Id: Guid
    - WorkspaceId: Guid
    - RecurrenceType: String
    - StartTimeLocal: String
    - Status: String
    --
  }

  class TranslationRoomSession <<entity>> {
    - Id: Guid
    - TranslationRoomId: Guid
    - MainLanguage: String
    - Status: String
    - StartedAt: DateTime
    --
  }

  TranslationRoomSeries -[hidden]right- TranslationRoom
  TranslationRoom -[hidden]right- TranslationRoomParticipant
  TranslationRoomParticipant -[hidden]right- TranslationRoomAudioRoute
  TranslationRoomAudioRoute -[hidden]right- TranslationRoomSession
}

TranslationRoomsController --> TranslationRoomService
TranslationRoomParticipantsController --> TranslationRoomParticipantService
TranslationRoomSeriesController --> TranslationRoomService

TranslationRoomService ..> TranslationRoomRepository
TranslationRoomService ..> TranslationRoomParticipantRepository
TranslationRoomService ..> UnitOfWork

TranslationRoomParticipantService ..> TranslationRoomParticipantRepository
TranslationRoomParticipantService ..> TranslationRoomRepository
TranslationRoomParticipantService ..> UnitOfWork

TranslationRoomAudioRouteService ..> TranslationRoomAudioRouteRepository
TranslationRoomAudioRouteService ..> AudioRouteStateMachine
TranslationRoomAudioRouteService ..> UnitOfWork

TranslationRoomRepository ..> TranslationRoomDbContext
TranslationRoomParticipantRepository ..> TranslationRoomDbContext
TranslationRoomAudioRouteRepository ..> TranslationRoomDbContext
UnitOfWork ..> TranslationRoomDbContext

TranslationRoomRepository ..> TranslationRoom : persists
TranslationRoomParticipantRepository ..> TranslationRoomParticipant : persists

TranslationRoomSeries *-- "0..*" TranslationRoom
TranslationRoom *-- "0..*" TranslationRoomParticipant
TranslationRoom *-- "0..*" TranslationRoomAudioRoute
TranslationRoom *-- "0..*" TranslationRoomSession

@enduml

@startuml
title 3.7 Billing Module Class Diagram (Report 4 Embedded Version)

top to bottom direction
hide circle

skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam dpi 140
skinparam titleFontSize 18
skinparam packageFontSize 16
skinparam classFontSize 14
skinparam classAttributeFontSize 12
skinparam ArrowFontSize 11
skinparam nodesep 36
skinparam ranksep 36
skinparam packageTitleAlignment left
skinparam packageStyle rectangle
skinparam packageBackgroundColor White
skinparam packageBorderColor Black
skinparam classBackgroundColor White
skinparam classBorderColor Black
skinparam ArrowColor Black

package "API Layer" as ApiLayer {
  class SubscriptionsController <<boundary>> {
    - subscriptionService: ISubscriptionService
    --
    + GetCurrentSubscription(workspaceId: Guid): Task<Result>
    + UpgradePlan(workspaceId: Guid, request: UpgradePlanRequest): Task<Result>
    + CancelSubscription(subscriptionId: Guid): Task<Result>
  }

  class PaymentsController <<boundary>> {
    - subscriptionService: ISubscriptionService
    - billingGateway: IStripeBillingGateway
    --
    + CreateCheckoutSession(request: CreateCheckoutRequest): Task<Result>
    + HandleStripeWebhook(payload: String, signature: String): Task<Result>
  }

  SubscriptionsController -[hidden]right- PaymentsController
}

package "Application Layer" as ApplicationLayer {
  class SubscriptionService <<control>> {
    - subscriptionRepository: ISubscriptionRepository
    - planRepository: IPlanRepository
    - creditService: ICreditService
    - billingGateway: IStripeBillingGateway
    - unitOfWork: IUnitOfWork
    --
    + CreateSubscriptionAsync(workspaceId: Guid, planId: Guid): Task<Result>
    + UpgradePlanAsync(workspaceId: Guid, newPlanId: Guid): Task<Result>
    + EvaluateServiceStateAsync(workspaceId: Guid): Task<Result>
  }

  class CreditService <<control>> {
    - subscriptionRepository: ISubscriptionRepository
    - creditTransactionRepository: ICreditTransactionRepository
    - unitOfWork: IUnitOfWork
    --
    + ConsumeCreditsAsync(workspaceId: Guid, amount: Decimal, chargeType: String): Task<Result>
    + TopUpCreditsAsync(workspaceId: Guid, amount: Decimal): Task<Result>
  }

  SubscriptionService -[hidden]right- CreditService
}

package "Infrastructure Layer" as InfrastructureLayer {
  class BillingDbContext <<control>> {
    + Plans: DbSet<Plan>
    + Subscriptions: DbSet<Subscription>
    + Payments: DbSet<Payment>
    + CreditTransactions: DbSet<CreditTransaction>
    + UsageRecords: DbSet<UsageRecord>
    --
    + SaveChangesAsync(): Task<Int>
  }

  class UnitOfWork <<control>> {
    - dbContext: BillingDbContext
    --
    + SaveChangesAsync(): Task<Int>
    + BeginTransactionAsync(): Task
    + CommitTransactionAsync(): Task
  }

  class SubscriptionRepository <<control>> {
    - dbContext: BillingDbContext
    --
    + GetByWorkspaceIdAsync(workspaceId: Guid): Task<Subscription>
    + AddAsync(subscription: Subscription): Task
    + Update(subscription: Subscription): void
  }

  class CreditTransactionRepository <<control>> {
    - dbContext: BillingDbContext
    --
    + GetBySubscriptionIdAsync(subscriptionId: Guid): Task<List<CreditTransaction>>
    + AddAsync(transaction: CreditTransaction): Task
  }

  class StripeBillingGateway <<control>> {
    - stripeApiKey: String
    --
    + CreateCheckoutSessionAsync(planId: String, email: String): Task<String>
    + VerifyWebhookSignature(payload: String, sigHeader: String): Boolean
  }

  SubscriptionRepository -[hidden]right- CreditTransactionRepository
  CreditTransactionRepository -[hidden]right- StripeBillingGateway
  BillingDbContext -[hidden]right- UnitOfWork
  SubscriptionRepository -[hidden]down- BillingDbContext
}

package "Domain Layer" as DomainLayer {
  class Plan <<entity>> {
    - Id: Guid
    - Name: String
    - Slug: String
    - Tier: String
    - Price: Decimal
    - Currency: String
    - CreditsPerCycle: Decimal
    - VoiceCloneEnabled: Boolean
    - AiAssistantEnabled: Boolean
    --
  }

  class Subscription <<entity>> {
    - Id: Guid
    - UserId: Guid
    - WorkspaceId: Guid
    - PlanId: Guid
    - Status: String
    - CreditsRemaining: Decimal
    - ServiceState: String
    - CurrentPeriodEnd: DateTime
    --
  }

  class Payment <<entity>> {
    - Id: Guid
    - SubscriptionId: Guid
    - Amount: Decimal
    - TotalAmount: Decimal
    - ProviderTransactionId: String
    - Status: String
    --
  }

  class CreditTransaction <<entity>> {
    - Id: Guid
    - SubscriptionId: Guid
    - Amount: Decimal
    - Type: String
    - ChargeType: String
    - BalanceAfter: Decimal
    --
  }

  class UsageRecord <<entity>> {
    - Id: Guid
    - SubscriptionId: Guid
    - WorkspaceId: Guid
    - UsageType: String
    - Quantity: Decimal
    - CreditsConsumed: Decimal
    --
  }

  Plan -[hidden]right- Subscription
  Subscription -[hidden]right- Payment
  Payment -[hidden]right- CreditTransaction
  CreditTransaction -[hidden]right- UsageRecord
}

package "External Systems" as ExternalSystems {
  class StripeApi <<external system>> {
    - apiEndpoint: String
    --
    + CreateCheckoutSessionAsync(params: Object): Task<Object>
    + VerifyWebhook(payload: String, sigHeader: String): Object
  }
}

SubscriptionsController --> SubscriptionService
PaymentsController --> SubscriptionService
PaymentsController --> StripeBillingGateway

SubscriptionService ..> SubscriptionRepository
SubscriptionService ..> CreditService
SubscriptionService ..> StripeBillingGateway
SubscriptionService ..> UnitOfWork

CreditService ..> SubscriptionRepository
CreditService ..> CreditTransactionRepository
CreditService ..> UnitOfWork

SubscriptionRepository ..> BillingDbContext
CreditTransactionRepository ..> BillingDbContext
UnitOfWork ..> BillingDbContext

SubscriptionRepository ..> Subscription : persists
CreditTransactionRepository ..> CreditTransaction : persists
StripeBillingGateway ..> StripeApi

Plan *-- "0..*" Subscription
Subscription *-- "0..*" Payment
Subscription *-- "0..*" CreditTransaction
Subscription *-- "0..*" UsageRecord

@enduml

@startuml
title 3.2 Workspace Module Class Diagram (Report 4 Embedded Version)

top to bottom direction
hide circle

skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam dpi 140
skinparam titleFontSize 18
skinparam packageFontSize 16
skinparam classFontSize 14
skinparam classAttributeFontSize 12
skinparam ArrowFontSize 11
skinparam nodesep 32
skinparam ranksep 40
skinparam packageTitleAlignment left
skinparam packageStyle rectangle
skinparam packageBackgroundColor White
skinparam packageBorderColor Black
skinparam classBackgroundColor White
skinparam classBorderColor Black
skinparam ArrowColor Black

package "API Layer" as ApiLayer {
  class WorkspacesController <<boundary>> {
    - workspaceService: IWorkspaceService
    --
    + CreateWorkspace(request: CreateWorkspaceRequest): Task<Result>
    + GetWorkspaces(query: GetWorkspacesQuery): Task<Result>
    + GetWorkspaceById(id: Guid): Task<Result>
    + SelectWorkspace(id: Guid): Task<Result>
  }

  class WorkspaceMembersController <<boundary>> {
    - memberService: IWorkspaceMemberService
    --
    + GetMembers(workspaceId: Guid): Task<Result>
    + UpdateMemberRole(workspaceId: Guid, userId: Guid, request: UpdateMemberRoleRequest): Task<Result>
    + RemoveMember(workspaceId: Guid, userId: Guid): Task<Result>
  }

  class WorkspaceInvitationsController <<boundary>> {
    - invitationService: IWorkspaceInvitationService
    --
    + InviteMember(workspaceId: Guid, request: InviteMemberRequest): Task<Result>
    + AcceptInvitation(request: AcceptInvitationRequest): Task<Result>
    + CreateJoinRequest(command: CreateJoinRequestCommand): Task<Result>
  }

  class WorkspaceDocumentsController <<boundary>> {
    - documentService: IWorkspaceDocumentService
    --
    + UploadDocument(workspaceId: Guid, request: UploadDocumentApiRequest): Task<Result>
    + ListDocuments(workspaceId: Guid, query: GetDocumentsQuery): Task<Result>
    + DownloadDocument(workspaceId: Guid, documentId: Guid): Task<Result>
  }

  class AdminWorkspacesController <<boundary>> {
    - adminWorkspaceService: IAdminWorkspaceService
    --
    + GetAllWorkspaces(query: AdminWorkspaceQuery): Task<Result>
    + UpdateWorkspaceStatus(workspaceId: Guid, status: String): Task<Result>
  }

  class WorkspaceGrpcService <<boundary>> {
    - workspaceService: IWorkspaceService
    --
    + ValidateWorkspaceAccess(request: ValidateAccessRequest): Task<ValidateAccessResponse>
  }

  WorkspacesController -[hidden]right- WorkspaceMembersController
  WorkspaceMembersController -[hidden]right- WorkspaceInvitationsController
  WorkspacesController -[hidden]down- WorkspaceDocumentsController
  WorkspaceDocumentsController -[hidden]right- AdminWorkspacesController
  AdminWorkspacesController -[hidden]right- WorkspaceGrpcService
}

package "Application Layer" as ApplicationLayer {
  class WorkspaceService <<control>> {
    - workspaceRepository: IWorkspaceRepository
    - memberRepository: IWorkspaceMemberRepository
    - unitOfWork: IUnitOfWork
    --
    + CreateWorkspaceAsync(request: CreateWorkspaceRequest): Task<Result>
    + GetWorkspacesAsync(query: GetWorkspacesQuery): Task<Result>
    + GetWorkspaceByIdAsync(workspaceId: Guid): Task<Result>
  }

  class WorkspaceMemberService <<control>> {
    - memberRepository: IWorkspaceMemberRepository
    - unitOfWork: IUnitOfWork
    --
    + GetMembersAsync(workspaceId: Guid): Task<Result>
    + UpdateMemberRoleAsync(workspaceId: Guid, userId: Guid, newRole: String): Task<Result>
    + RemoveMemberAsync(workspaceId: Guid, userId: Guid): Task<Result>
  }

  class WorkspaceInvitationService <<control>> {
    - invitationRepository: IWorkspaceInvitationRepository
    - memberRepository: IWorkspaceMemberRepository
    - unitOfWork: IUnitOfWork
    --
    + InviteMemberAsync(workspaceId: Guid, request: InviteMemberRequest): Task<Result>
    + AcceptInvitationAsync(request: AcceptInvitationRequest): Task<Result>
  }

  class WorkspaceDocumentService <<control>> {
    - documentRepository: IWorkspaceDocumentRepository
    - storage: IWorkspaceDocumentStorage
    - unitOfWork: IUnitOfWork
    --
    + UploadDocumentAsync(workspaceId: Guid, request: UploadDocumentApiRequest): Task<Result>
    + ListDocumentsAsync(workspaceId: Guid, query: GetDocumentsQuery): Task<Result>
  }

  class WorkspaceKnowledgeService <<control>> {
    - vectorStoreAdapter: IQdrantVectorStoreAdapter
    - documentRepository: IWorkspaceDocumentRepository
    --
    + IndexDocumentChunksAsync(documentId: Guid, chunks: List<String>): Task<Result>
    + SearchKnowledgeAsync(workspaceId: Guid, query: String): Task<List<String>>
  }

  class AdminWorkspaceService <<control>> {
    - workspaceRepository: IWorkspaceRepository
    - unitOfWork: IUnitOfWork
    --
    + AdminGetWorkspacesAsync(query: AdminWorkspaceQuery): Task<Result>
    + AdminSetWorkspaceStatusAsync(workspaceId: Guid, isActive: Boolean): Task<Result>
  }

  class VerifiedDomainService <<control>> {
    - domainRepository: IWorkspaceVerifiedDomainRepository
    - unitOfWork: IUnitOfWork
    --
    + AddDomainAsync(workspaceId: Guid, domainName: String): Task<Result>
    + VerifyDomainDnsAsync(domainId: Guid): Task<Result>
  }

  WorkspaceService -[hidden]right- WorkspaceMemberService
  WorkspaceMemberService -[hidden]right- WorkspaceInvitationService
  WorkspaceInvitationService -[hidden]right- WorkspaceDocumentService
  WorkspaceService -[hidden]down- WorkspaceKnowledgeService
  WorkspaceKnowledgeService -[hidden]right- AdminWorkspaceService
  AdminWorkspaceService -[hidden]right- VerifiedDomainService
}

package "Infrastructure Layer" as InfrastructureLayer {
  class WorkspaceDbContext <<control>> {
    + Workspaces: DbSet<Workspace>
    + WorkspaceMembers: DbSet<WorkspaceMember>
    + WorkspaceInvitations: DbSet<WorkspaceInvitation>
    + WorkspaceDocuments: DbSet<WorkspaceDocument>
    + WorkspaceDocumentAccessPolicies: DbSet<WorkspaceDocumentAccessPolicy>
    + WorkspaceVerifiedDomains: DbSet<WorkspaceVerifiedDomain>
    + WorkspaceAdminActions: DbSet<WorkspaceAdminAction>
    --
    + SaveChangesAsync(): Task<Int>
  }

  class UnitOfWork <<control>> {
    - dbContext: WorkspaceDbContext
    --
    + SaveChangesAsync(): Task<Int>
    + BeginTransactionAsync(): Task
    + CommitTransactionAsync(): Task
  }

  class WorkspaceRepository <<control>> {
    - dbContext: WorkspaceDbContext
    --
    + GetByIdAsync(id: Guid): Task<Workspace>
    + GetWorkspacesForUserAsync(userId: Guid): Task<List<Workspace>>
    + AddAsync(workspace: Workspace): Task
  }

  class WorkspaceMemberRepository <<control>> {
    - dbContext: WorkspaceDbContext
    --
    + GetActiveMembersByWorkspaceAsync(workspaceId: Guid): Task<List<WorkspaceMember>>
    + AddAsync(member: WorkspaceMember): Task
  }

  class WorkspaceInvitationRepository <<control>> {
    - dbContext: WorkspaceDbContext
    --
    + GetByTokenHashAsync(tokenHash: String): Task<WorkspaceInvitation>
    + AddAsync(invitation: WorkspaceInvitation): Task
  }

  class WorkspaceDocumentRepository <<control>> {
    - dbContext: WorkspaceDbContext
    --
    + GetPagedDocumentsAsync(workspaceId: Guid): Task<List<WorkspaceDocument>>
    + AddAsync(document: WorkspaceDocument): Task
  }

  class WorkspaceVerifiedDomainRepository <<control>> {
    - dbContext: WorkspaceDbContext
    --
    + GetByWorkspaceIdAsync(workspaceId: Guid): Task<List<WorkspaceVerifiedDomain>>
    + AddAsync(domain: WorkspaceVerifiedDomain): Task
  }

  class LocalEncryptedWorkspaceDocumentStorage <<control>> {
    - storageOptions: ObjectStorageOptions
    --
    + SaveDocumentContentAsync(document: WorkspaceDocument, stream: Stream): Task
    + ReadDocumentContentAsync(document: WorkspaceDocument): Task<Stream>
  }

  class QdrantVectorStoreAdapter <<control>> {
    - qdrantClient: QdrantClient
    --
    + UpsertVectorsAsync(collection: String, vectors: List<VectorRecord>): Task
    + QuerySimilarVectorsAsync(collection: String, vector: List<Single>): Task<List<String>>
  }

  WorkspaceDbContext -[hidden]right- UnitOfWork
  UnitOfWork -[hidden]right- WorkspaceRepository
  WorkspaceRepository -[hidden]right- WorkspaceMemberRepository
  WorkspaceMemberRepository -[hidden]right- WorkspaceInvitationRepository
  WorkspaceRepository -[hidden]down- WorkspaceDocumentRepository
  WorkspaceDocumentRepository -[hidden]right- WorkspaceVerifiedDomainRepository
  WorkspaceVerifiedDomainRepository -[hidden]right- LocalEncryptedWorkspaceDocumentStorage
  LocalEncryptedWorkspaceDocumentStorage -[hidden]right- QdrantVectorStoreAdapter
}

package "Domain Layer" as DomainLayer {
  class Workspace <<entity>> {
    - Id: Guid
    - Name: String
    - Slug: String
    - OwnerId: Guid
    - AvatarUrl: String
    - IsActive: Boolean
    - CreatedAt: DateTime
    --
  }

  class WorkspaceMember <<entity>> {
    - Id: Guid
    - WorkspaceId: Guid
    - UserId: Guid
    - RoleId: Guid
    - Status: String
    - JoinedAt: DateTime
    --
  }

  class WorkspaceInvitation <<entity>> {
    - Id: Guid
    - WorkspaceId: Guid
    - Email: String
    - TokenHash: String
    - RoleId: Guid
    - Status: String
    - ExpiresAt: DateTime
    --
  }

  class WorkspaceDocument <<entity>> {
    - Id: Guid
    - WorkspaceId: Guid
    - StorageKey: String
    - FileName: String
    - FileExtension: String
    - FileSizeBytes: Long
    - IngestionStatus: String
    --
  }

  class WorkspaceDocumentAccessPolicy <<entity>> {
    - Id: Guid
    - DocumentId: Guid
    - TargetRole: String
    - CanRead: Boolean
    - CanWrite: Boolean
    --
  }

  class WorkspaceVerifiedDomain <<entity>> {
    - Id: Guid
    - WorkspaceId: Guid
    - DomainName: String
    - IsVerified: Boolean
    - VerifiedAt: DateTime?
    --
  }

  class WorkspaceAdminAction <<entity>> {
    - Id: Guid
    - WorkspaceId: Guid
    - AdminUserId: Guid
    - ActionType: String
    - DetailsJson: String
    - PerformedAt: DateTime
    --
  }

  Workspace -[hidden]right- WorkspaceMember
  WorkspaceMember -[hidden]right- WorkspaceInvitation
  WorkspaceInvitation -[hidden]right- WorkspaceDocument
  Workspace -[hidden]down- WorkspaceDocumentAccessPolicy
  WorkspaceDocumentAccessPolicy -[hidden]right- WorkspaceVerifiedDomain
  WorkspaceVerifiedDomain -[hidden]right- WorkspaceAdminAction
}

WorkspacesController --> WorkspaceService
WorkspaceMembersController --> WorkspaceMemberService
WorkspaceInvitationsController --> WorkspaceInvitationService
WorkspaceDocumentsController --> WorkspaceDocumentService
AdminWorkspacesController --> AdminWorkspaceService
WorkspaceGrpcService --> WorkspaceService

WorkspaceService ..> WorkspaceRepository
WorkspaceService ..> WorkspaceMemberRepository
WorkspaceService ..> UnitOfWork

WorkspaceMemberService ..> WorkspaceMemberRepository
WorkspaceMemberService ..> UnitOfWork

WorkspaceInvitationService ..> WorkspaceInvitationRepository
WorkspaceInvitationService ..> WorkspaceMemberRepository
WorkspaceInvitationService ..> UnitOfWork

WorkspaceDocumentService ..> WorkspaceDocumentRepository
WorkspaceDocumentService ..> LocalEncryptedWorkspaceDocumentStorage
WorkspaceDocumentService ..> UnitOfWork

WorkspaceKnowledgeService ..> QdrantVectorStoreAdapter
WorkspaceKnowledgeService ..> WorkspaceDocumentRepository

AdminWorkspaceService ..> WorkspaceRepository
AdminWorkspaceService ..> UnitOfWork

VerifiedDomainService ..> WorkspaceVerifiedDomainRepository
VerifiedDomainService ..> UnitOfWork

WorkspaceRepository ..> WorkspaceDbContext
WorkspaceMemberRepository ..> WorkspaceDbContext
WorkspaceInvitationRepository ..> WorkspaceDbContext
WorkspaceDocumentRepository ..> WorkspaceDbContext
WorkspaceVerifiedDomainRepository ..> WorkspaceDbContext
UnitOfWork ..> WorkspaceDbContext

WorkspaceRepository ..> Workspace : persists
WorkspaceMemberRepository ..> WorkspaceMember : persists
WorkspaceInvitationRepository ..> WorkspaceInvitation : persists
WorkspaceDocumentRepository ..> WorkspaceDocument : persists
WorkspaceVerifiedDomainRepository ..> WorkspaceVerifiedDomain : persists

Workspace *-- "0..*" WorkspaceMember
Workspace *-- "0..*" WorkspaceInvitation
Workspace *-- "0..*" WorkspaceDocument
Workspace *-- "0..*" WorkspaceVerifiedDomain
Workspace *-- "0..*" WorkspaceAdminAction
WorkspaceDocument *-- "0..*" WorkspaceDocumentAccessPolicy

@enduml

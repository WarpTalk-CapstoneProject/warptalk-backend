@startuml

top to bottom direction
hide circle
hide empty members

skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 40
skinparam ArrowFontSize 11
skinparam packageStyle rectangle
skinparam packageBackgroundColor White
skinparam packageBorderColor Black
skinparam ArrowColor Black

package "WarpTalk System" as WarpTalkSystem {
  package "Client Repositories" as ClientRepos {
    package "warptalk-web"
    package "warptalk-desktop"

    "warptalk-web" -[hidden]right- "warptalk-desktop"
  }

  package "warptalk-backend" as Backend {
    package "gateway"
    package "auth"
    package "workspace"
    package "meeting"
    package "translation-room"
    package "transcript"
    package "assistant"
    package "billing"
    package "notification"
    package "shared <<abstract>>"
    package "contracts <<abstract>>"

    ' Grid 3-column layout inside Backend for compact height
    "gateway" -[hidden]right- "auth"
    "auth" -[hidden]right- "workspace"
    "workspace" -[hidden]right- "meeting"

    "gateway" -[hidden]down- "translation-room"
    "translation-room" -[hidden]right- "transcript"
    "transcript" -[hidden]right- "assistant"
    "assistant" -[hidden]right- "billing"

    "translation-room" -[hidden]down- "notification"
    "notification" -[hidden]right- "shared <<abstract>>"
    "shared <<abstract>>" -[hidden]right- "contracts <<abstract>>"
  }

  package "warptalk-ai" as AIRuntime {
    package "livekit_ingress_worker"
    package "stt_worker"
    package "translation_worker"
    package "tts_worker"
    package "ai_assistant_worker"
    package "embedding_worker"
    package "suggestion_worker"
    package "security_worker"
    package "billing_worker"
    package "metrics_exporter"
    package "AI shared <<abstract>>"

    ' Grid 3-column layout inside AI Runtime
    "livekit_ingress_worker" -[hidden]right- "stt_worker"
    "stt_worker" -[hidden]right- "translation_worker"

    "livekit_ingress_worker" -[hidden]down- "tts_worker"
    "tts_worker" -[hidden]right- "ai_assistant_worker"
    "ai_assistant_worker" -[hidden]right- "embedding_worker"

    "tts_worker" -[hidden]down- "suggestion_worker"
    "suggestion_worker" -[hidden]right- "security_worker"
    "security_worker" -[hidden]right- "billing_worker"
    "billing_worker" -[hidden]right- "metrics_exporter"
    "metrics_exporter" -[hidden]right- "AI shared <<abstract>>"
  }

  package "warptalk-infrastructure" as Infrastructure {
    package "terraform"
    package "deploy"
    package "observability"
    package "pgbouncer"
    package "coturn"

    "terraform" -[hidden]right- "deploy"
    "deploy" -[hidden]right- "observability"
    "observability" -[hidden]right- "pgbouncer"
    "pgbouncer" -[hidden]right- "coturn"
  }

}

' System dependency alignment
ClientRepos ..> Backend
Backend ..> AIRuntime

ClientRepos -[hidden]right- Backend
ClientRepos -[hidden]down- AIRuntime
Backend -[hidden]down- Infrastructure
AIRuntime -[hidden]right- Infrastructure

@enduml

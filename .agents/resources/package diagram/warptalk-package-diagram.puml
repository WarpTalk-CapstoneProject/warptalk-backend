@startuml
title 1.2 WarpTalk System-Level Package Diagram

left to right direction
hide circle
hide empty members

skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 75
skinparam ArrowFontSize 11
skinparam packageStyle rectangle
skinparam packageBackgroundColor White
skinparam packageBorderColor Black
skinparam ArrowColor Black

package "Client Repositories" as ClientRepos {
  package "warptalk-web" as Web
  package "warptalk-desktop" as Desktop

  Web -[hidden]down- Desktop
}

package "warptalk-backend" as Backend {
  package "gateway" as Gateway
  package "auth" as Auth
  package "workspace" as Workspace
  package "meeting" as Meeting
  package "translation-room" as TranslationRoom
  package "transcript" as Transcript
  package "assistant" as Assistant
  package "billing" as Billing
  package "notification" as Notification
  package "payment" as Payment
  package "shared <<abstract>>" as BackendShared
  package "contracts <<abstract>>" as BackendContracts

  Gateway -[hidden]down- Auth
  Auth -[hidden]down- Workspace
  Workspace -[hidden]down- Meeting
  Meeting -[hidden]down- TranslationRoom
  TranslationRoom -[hidden]down- Transcript
  Transcript -[hidden]down- Assistant
  Assistant -[hidden]down- Billing
  Billing -[hidden]down- Notification
  Notification -[hidden]down- Payment
  Payment -[hidden]down- BackendShared
  BackendShared -[hidden]down- BackendContracts
}

package "warptalk-ai" as AIRuntime {
  package "livekit_ingress_worker" as IngressWorker
  package "stt_worker" as SttWorker
  package "translation_worker" as TranslationWorker
  package "tts_worker" as TtsWorker
  package "ai_assistant_worker" as AssistantWorker
  package "embedding_worker" as EmbeddingWorker
  package "security_worker" as SecurityWorker
  package "billing_worker" as BillingWorker
  package "metrics_exporter" as MetricsExporter
  package "shared <<abstract>>" as AIShared

  IngressWorker -[hidden]down- SttWorker
  SttWorker -[hidden]down- TranslationWorker
  TranslationWorker -[hidden]down- TtsWorker
  TtsWorker -[hidden]down- AssistantWorker
  AssistantWorker -[hidden]down- EmbeddingWorker
  EmbeddingWorker -[hidden]down- SecurityWorker
  SecurityWorker -[hidden]down- BillingWorker
  BillingWorker -[hidden]down- MetricsExporter
  MetricsExporter -[hidden]down- AIShared
}

package "warptalk-infrastructure" as Infrastructure {
  package "terraform" as Terraform
  package "deploy" as Deploy
  package "observability" as Observability
  package "pgbouncer" as Pgbouncer
  package "coturn" as Coturn

  Terraform -[hidden]down- Deploy
  Deploy -[hidden]down- Observability
  Observability -[hidden]down- Pgbouncer
  Pgbouncer -[hidden]down- Coturn
}

ClientRepos ..> Backend
Backend ..> AIRuntime
Infrastructure ..> Backend
Infrastructure ..> AIRuntime

ClientRepos -[hidden]right- Backend
Backend -[hidden]right- AIRuntime
AIRuntime -[hidden]right- Infrastructure
@enduml

@startuml
title 1.2 WarpTalk Package Diagram

left to right direction
hide circle
hide empty members

skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 85
skinparam ArrowFontSize 11
skinparam packageStyle rectangle
skinparam packageBackgroundColor White
skinparam packageBorderColor Black
skinparam ArrowColor Black

package "Client Apps" as ClientApps {
  package "warptalk-web" as Web
  package "warptalk-desktop" as Desktop

  Web -[hidden]down- Desktop
}

package "Backend Services" as Backend {
  package "Auth Service" as Auth
  package "Workspace Service" as Workspace
  package "Meeting Service" as Meeting
  package "Translation Room Service" as TranslationRoom
  package "Transcript Service" as Transcript
  package "Billing Service" as Billing
  package "Notification Service" as Notification
  package "Assistant Service" as Assistant

  Auth -[hidden]down- Workspace
  Workspace -[hidden]down- Meeting
  Meeting -[hidden]down- TranslationRoom
  TranslationRoom -[hidden]down- Transcript
  Transcript -[hidden]down- Billing
  Billing -[hidden]down- Notification
  Notification -[hidden]down- Assistant
}

package "AI Workers" as AIWorkers {
  package "security_worker" as SecurityWorker
  package "embedding_worker" as EmbeddingWorker
  package "translation_worker" as TranslationWorker
  package "stt_worker" as SttWorker
  package "tts_worker" as TtsWorker
  package "billing_worker" as BillingWorker
  package "ai_assistant_worker" as AssistantWorker
  package "livekit_ingress_worker" as IngressWorker

  SecurityWorker -[hidden]down- EmbeddingWorker
  EmbeddingWorker -[hidden]down- TranslationWorker
  TranslationWorker -[hidden]down- SttWorker
  SttWorker -[hidden]down- TtsWorker
  TtsWorker -[hidden]down- BillingWorker
  BillingWorker -[hidden]down- AssistantWorker
  AssistantWorker -[hidden]down- IngressWorker
}

package "Infrastructure" as Infrastructure {
  package "warptalk-infrastructure" as InfraRepo
  package "Terraform" as Terraform
  package "Docker Compose" as DockerCompose
  package "Observability" as Observability
  package "Database Migrations" as Migrations

  InfraRepo -[hidden]down- Terraform
  Terraform -[hidden]down- DockerCompose
  DockerCompose -[hidden]down- Observability
  Observability -[hidden]down- Migrations
}

package "External Systems" as ExternalSystems {
  package "PostgreSQL" as PostgreSQL
  package "Redis" as Redis
  package "Qdrant" as Qdrant
  package "LiveKit" as LiveKit
  package "Stripe" as Stripe
  package "Google APIs" as GoogleApis
  package "OpenAI / Gemini" as LlmApis

  PostgreSQL -[hidden]down- Redis
  Redis -[hidden]down- Qdrant
  Qdrant -[hidden]down- LiveKit
  LiveKit -[hidden]down- Stripe
  Stripe -[hidden]down- GoogleApis
  GoogleApis -[hidden]down- LlmApis
}

ClientApps --> Backend
Backend --> AIWorkers
Backend --> ExternalSystems
AIWorkers --> ExternalSystems
Infrastructure ..> Backend
Infrastructure ..> AIWorkers

ClientApps -[hidden]right- Backend
Backend -[hidden]right- AIWorkers
AIWorkers -[hidden]right- Infrastructure
Infrastructure -[hidden]right- ExternalSystems
@enduml

@startuml
title Backend Clean Architecture Package Diagram

left to right direction
hide circle
hide empty members

skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 85
skinparam ArrowFontSize 11
skinparam packageStyle rectangle
skinparam packageBackgroundColor White
skinparam packageBorderColor Black
skinparam ArrowColor Black

package "API (Presentation Layer)" as API {
  package Controllers
  package GrpcServices
  package Middlewares
  package Validators
  package Extensions
}

package "Application Layer" as Application {
  package Services
  package Interfaces
  package DTOs
  package Mappers
  package Helpers
}

package "Domain Layer (Core)" as Domain {
  package Entities
  package Enums
  package ValueObjects
  package Interfaces as DomainInterfaces
  package Constants
  package Settings
}

package "Infrastructure Layer" as Infrastructure {
  package Repositories
  package Persistence
  package BackgroundServices
  package Messaging
  package Security
  package Clients
}

' -------------------------------------------------------------
' Clean Architecture Dependency Rules (Dependency Inversion)
' -------------------------------------------------------------
API ..> Application : depends on
Application ..> Domain : depends on
Infrastructure ..> Application : implements interfaces
Infrastructure ..> Domain : depends on

@enduml

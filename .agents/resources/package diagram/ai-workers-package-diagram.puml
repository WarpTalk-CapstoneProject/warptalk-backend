@startuml

left to right direction
hide circle
hide empty members

skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 85
skinparam ArrowFontSize 11
skinparam packageStyle rectangle
skinparam packageBackgroundColor White
skinparam packageBorderColor Black
skinparam ArrowColor Black

package "warptalk-ai" as AIRoot {
  package "livekit_ingress_worker"
  package "stt_worker"
  package "translation_worker"
  package "tts_worker"

  package "ai_assistant_worker"
  package "embedding_worker"
  package "suggestion_worker"
  package "security_worker"
  package "billing_worker"

  package "metrics_exporter"
  package "tools"
  package "benchmarks"
  package "tests"

  package "shared <<abstract>>" as SharedPkg

  ' -------------------------------------------------------------
  ' Shared Foundation Dependency Rule (grouped)
  ' -------------------------------------------------------------
  AIRoot ..> SharedPkg
}

@enduml

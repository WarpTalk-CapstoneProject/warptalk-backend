@startuml
title AI Workers Package Diagram (warptalk-ai)

left to right direction
hide circle
hide empty members

skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 85
skinparam ArrowFontSize 11
skinparam packageStyle rectangle
skinparam packageBackgroundColor White
skinparam packageBorderColor Black
skinparam ArrowColor Black

package "livekit_ingress_worker" as livekit
package "stt_worker" as stt
package "translation_worker" as translation
package "tts_worker" as tts

package "ai_assistant_worker" as assistant
package "embedding_worker" as embedding
package "security_worker" as security
package "billing_worker" as billing

package "metrics_exporter" as metrics
package "tools" as tools
package "benchmarks" as benchmarks
package "tests" as tests

package "shared <<abstract>>" as shared

' -------------------------------------------------------------
' Dependency Rules
' -------------------------------------------------------------
livekit ..> stt
stt ..> translation
translation ..> tts

livekit ..> shared
stt ..> shared
translation ..> shared
tts ..> shared

assistant ..> shared
embedding ..> shared
security ..> shared
billing ..> shared

metrics ..> shared
tools ..> shared
benchmarks ..> shared
tests ..> shared

@enduml

@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
left to right direction

' Screen Nodes
rectangle "Workspace Home Page" as WorkspaceHome
rectangle "Billing & Wallet Page" as BillingWalletPage
rectangle "Top-Up Plans Page" as TopUpPlansPage
rectangle "Payment Checkout Gateway" as CheckoutGateway
rectangle "Payment Success Page" as PaymentSuccessPage
rectangle "Payment Cancelled Page" as PaymentCancelledPage

' Flow: Accessing Credit Top Up
WorkspaceHome --> BillingWalletPage : Click "Billing & Credits"
BillingWalletPage --> TopUpPlansPage : Click "Top Up Credits"

' Flow: Credit Package Selection & Payment
TopUpPlansPage --> CheckoutGateway : Click "Top up 10,000 / 25,000 / 50,000 Credits"
CheckoutGateway --> PaymentSuccessPage : Payment Successful
CheckoutGateway --> PaymentCancelledPage : Payment Failed or Cancelled

' Flow: Return & Balance Synchronization
PaymentSuccessPage --> BillingWalletPage : Click "Return to Wallet" (credits balance updated)
PaymentCancelledPage --> TopUpPlansPage : Click "Try Again"

@enduml

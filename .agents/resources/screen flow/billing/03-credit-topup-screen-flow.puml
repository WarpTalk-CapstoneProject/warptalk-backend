@startuml
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
left to right direction

' Screen Nodes
rectangle "Workspace Home Page" as WorkspaceHome
rectangle "Workspace Dashboard Page" as WorkspaceDashboardPage
rectangle "Workspace Settings Page" as WorkspaceSettingsPage
rectangle "Billing Page" as BillingPage
rectangle "Plans Page" as PlansPage
rectangle "Stripe Checkout" as StripeCheckout
rectangle "Payment Success Page" as PaymentSuccessPage
rectangle "Payment Cancelled Page" as PaymentCancelledPage

' Flow: Accessing Dashboard & Settings from Home
WorkspaceHome --> WorkspaceDashboardPage
WorkspaceHome --> WorkspaceSettingsPage
WorkspaceSettingsPage --> BillingPage

' Flow: Credit Tracking & Navigation from Dashboard
WorkspaceDashboardPage --> BillingPage
WorkspaceDashboardPage --> PlansPage

' Views & Actions inside Billing Page
BillingPage --> PlansPage

' Checkout & Payment Gateway Flow
PlansPage --> StripeCheckout
StripeCheckout --> PaymentSuccessPage
StripeCheckout --> PaymentCancelledPage

' Return flows back to Billing Page / Plans Page
PaymentSuccessPage --> BillingPage
PaymentCancelledPage --> PlansPage

@enduml

@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
left to right direction

rectangle "Landing Page" as LandingPage
rectangle "Login Page" as LoginPage
rectangle "Pricing Page" as PricingPage
rectangle "Checkout Page" as CheckoutPage
rectangle "Create Workspace Page" as CreateWorkspacePage
rectangle "Workspace Home Page" as WorkspaceHome

' Flow 1: Login First -> Buy Plan -> Create Workspace
LandingPage --> LoginPage : Click "Login"
LoginPage --> PricingPage : Click "Submit" (with valid credentials)
PricingPage --> CheckoutPage : Click "Select Plan"
CheckoutPage --> CreateWorkspacePage : Click "Pay Now" (payment success)
CreateWorkspacePage --> WorkspaceHome : Click "Create Workspace"

' Flow 2: Buy Plan First -> Login -> Create Workspace
LandingPage --> PricingPage : Click "Buy Plan"
PricingPage --> LoginPage : Click "Select Plan"
LoginPage --> CheckoutPage : Click "Submit" (with valid credentials)

' Cancellation / Failure flow
CheckoutPage --> PricingPage : Click "Cancel" / Payment Failed

@enduml

@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
left to right direction

rectangle "Landing Page" as LandingPage
rectangle "Login Page" as LoginPage
rectangle "Pricing Page" as PricingPage
rectangle "Checkout Page" as CheckoutPage
rectangle "Create Workspace Page" as CreateWorkspacePage
rectangle "Workspace Home Page" as WorkspaceHome

' Flow 1: Login First -> Buy Plan -> Create Workspace
LandingPage --> LoginPage
LoginPage --> PricingPage
PricingPage --> CheckoutPage
CheckoutPage --> CreateWorkspacePage
CreateWorkspacePage --> WorkspaceHome

' Flow 2: Buy Plan First -> Login -> Create Workspace
LandingPage --> PricingPage
PricingPage --> LoginPage
LoginPage --> CheckoutPage

' Cancellation / Failure flow
CheckoutPage --> PricingPage

@enduml

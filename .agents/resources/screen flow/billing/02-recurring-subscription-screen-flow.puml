@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
left to right direction

rectangle "Workspace Home Page" as WorkspaceHome
rectangle "Workspace Settings Page" as WorkspaceSettingsPage
rectangle "Billing Page" as BillingPage
rectangle "Plan Upgrade Modal" as PlanUpgradeModal
rectangle "Checkout Page" as CheckoutPage

WorkspaceHome --> WorkspaceSettingsPage
WorkspaceSettingsPage --> BillingPage
BillingPage --> PlanUpgradeModal
PlanUpgradeModal --> CheckoutPage
CheckoutPage --> BillingPage
CheckoutPage --> BillingPage

@enduml

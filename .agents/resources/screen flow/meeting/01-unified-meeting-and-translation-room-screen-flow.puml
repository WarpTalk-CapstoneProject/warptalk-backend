@startuml
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
left to right direction

' Screen Nodes & Modals
rectangle "Workspace Home Page" as WorkspaceHome
rectangle "Rooms List Page" as RoomsListPage
rectangle "Schedules Page" as SchedulesPage
rectangle "Create Room Modal" as CreateRoomModal
rectangle "Setup Room Dialog" as SetupRoomDialog
rectangle "Room Information Page" as RoomInformationPage
rectangle "Waiting Room Page" as WaitingRoomPage
rectangle "Active Meeting Room Page" as MeetingRoomPage
rectangle "Device & Language Settings Modal" as DeviceSettingsModal
rectangle "In-Meeting Translated Chat Panel" as MeetingChatPanel
rectangle "Live Transcript Feed Panel" as LiveTranscriptPanel
rectangle "WarpBot In-Meeting AI Suggestion Panel" as WarpBotMeetingPanel
rectangle "Room Ended Summary Page" as RoomEndedSummaryPage
rectangle "Room Artifacts Page" as RoomArtifactsPage
rectangle "History Page" as HistoryPage
rectangle "Feedback Page" as FeedbackPage

' Room Creation & Setup Flow
WorkspaceHome --> RoomsListPage
WorkspaceHome --> SchedulesPage
RoomsListPage --> CreateRoomModal
CreateRoomModal --> SetupRoomDialog
CreateRoomModal --> RoomInformationPage

' Preflight & Device Configuration Flow
RoomsListPage --> RoomInformationPage
SchedulesPage --> RoomInformationPage
RoomInformationPage --> SetupRoomDialog
SetupRoomDialog --> SetupRoomDialog

' Room Entry Flow
RoomInformationPage --> WaitingRoomPage
WaitingRoomPage --> MeetingRoomPage
SetupRoomDialog --> MeetingRoomPage

' Active Meeting In-Room Interactions & Panels
MeetingRoomPage --> DeviceSettingsModal
DeviceSettingsModal --> MeetingRoomPage

MeetingRoomPage --> MeetingChatPanel
MeetingChatPanel --> MeetingRoomPage

MeetingRoomPage --> LiveTranscriptPanel
LiveTranscriptPanel --> MeetingRoomPage

' WarpBot In-Meeting Real-Time Context Suggestion Flow
MeetingRoomPage --> WarpBotMeetingPanel
WarpBotMeetingPanel --> MeetingRoomPage

' Meeting Exit & Artifact View Flow
MeetingRoomPage --> RoomEndedSummaryPage
RoomEndedSummaryPage --> RoomArtifactsPage
RoomEndedSummaryPage --> HistoryPage
RoomEndedSummaryPage --> FeedbackPage

@enduml

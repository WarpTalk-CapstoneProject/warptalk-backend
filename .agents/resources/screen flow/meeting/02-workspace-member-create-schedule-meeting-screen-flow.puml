@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
left to right direction

' Exact Route Components & Modals in warptalk-web
rectangle "Workspace Rooms Page" as WorkspaceRoomsPage
rectangle "Create Room Modal" as CreateRoomModal
rectangle "Daily Recurrence Schedule Modal" as DailyScheduleModal
rectangle "Room Setup Modal" as RoomSetupModal
rectangle "Room Information Page" as RoomInformationPage
rectangle "Waiting Room Page" as WaitingRoomPage

' 1. Open Create Room Modal
WorkspaceRoomsPage --> CreateRoomModal

' 2. Configure Meeting & Schedule Settings inside Create Room Modal
CreateRoomModal --> DailyScheduleModal
DailyScheduleModal --> CreateRoomModal

' 3. Form Submit & Success State inside Create Room Modal
CreateRoomModal --> RoomSetupModal
RoomSetupModal --> RoomInformationPage

CreateRoomModal --> RoomInformationPage
CreateRoomModal --> WorkspaceRoomsPage

' 4. Room Entry & Lobby Handling
RoomInformationPage --> WaitingRoomPage

@enduml

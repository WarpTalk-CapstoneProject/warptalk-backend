@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
left to right direction

rectangle "Landing Page" as LandingPage
rectangle "Login Page" as LoginPage
rectangle "Register Page" as RegisterPage
rectangle "Forgot Password Page" as ForgotPasswordPage
rectangle "Reset Password Page" as ResetPasswordPage
rectangle "Verify Email Page" as VerifyEmailPage
rectangle "Terms Page" as TermsPage
rectangle "Privacy Page" as PrivacyPage
rectangle "Workspace Invitation Page" as WorkspaceInvitationPage
rectangle "Workspace Selection Page" as WorkspaceSelectionPage

LandingPage --> LoginPage : Click "Get Started for Free"
LandingPage --> RegisterPage : Click "Create an Account"

LoginPage --> ForgotPasswordPage : Click "Forgot password?"
LoginPage --> RegisterPage : Click "Create account"
LoginPage --> TermsPage : Click "Terms of use"
LoginPage --> PrivacyPage : Click "Privacy policy"

ForgotPasswordPage --> ResetPasswordPage : Click "Send Reset Link" (check email)
ResetPasswordPage --> LoginPage : Click "Reset Password" (success)

RegisterPage --> VerifyEmailPage : Click "Sign Up"
RegisterPage --> LoginPage : Click "Log in"
VerifyEmailPage --> LoginPage : Click "Continue to Login"

LoginPage --> WorkspaceSelectionPage : Click "Submit" (with valid credentials)
WorkspaceInvitationPage --> RegisterPage : Click "Sign In to Accept"
WorkspaceInvitationPage --> WorkspaceSelectionPage : Click "Accept and Join Workspace"

@enduml

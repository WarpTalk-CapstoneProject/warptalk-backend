@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam dpi 136
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
left to right direction

package "Guest Or Invited User" {
  rectangle "Landing Page" as LandingPage
  rectangle "Login Page" as LoginPage
  rectangle "Register Page" as RegisterPage
  rectangle "Forgot Password Page" as ForgotPasswordPage
  rectangle "Verify Email Page" as VerifyEmailPage
  rectangle "Workspace Invitation Page" as WorkspaceInvitationPage
  rectangle "Workspace Selection Page" as GuestWorkspaceSelectionPage

  LandingPage --> LoginPage : Click "Get Started for Free"
  LandingPage --> RegisterPage : Click "Create an Account"
  LoginPage --> ForgotPasswordPage : Click "Forgot password?"
  LoginPage --> RegisterPage : Click "Create account"
  RegisterPage --> LoginPage : Click "Log in"
  VerifyEmailPage --> LoginPage : Click "Continue to Login"
  WorkspaceInvitationPage --> RegisterPage : Click "Sign In to Accept"
  WorkspaceInvitationPage --> GuestWorkspaceSelectionPage : Click "Accept and Join Workspace"
}

package "Workspace Member" {
  rectangle "Workspace Selection Page" as MemberWorkspaceSelectionPage
  rectangle "Workspace Join Request Page" as WorkspaceJoinRequestPage
  rectangle "Workspace Home Page" as WorkspaceHomePage
  rectangle "Rooms Page" as RoomsPage
  rectangle "Join Translation Room Page" as JoinTranslationRoomPage
  rectangle "Room Information Page" as RoomInformationPage
  rectangle "Waiting Room Page" as WaitingRoomPage
  rectangle "Live Meeting Page" as LiveMeetingPage
  rectangle "History Page" as HistoryPage
  rectangle "Documents Page" as DocumentsPage
  rectangle "Document Details Page" as DocumentDetailsPage

  MemberWorkspaceSelectionPage --> WorkspaceHomePage : Click Workspace Card
  MemberWorkspaceSelectionPage --> WorkspaceJoinRequestPage : Click "Join workspace"
  WorkspaceJoinRequestPage --> JoinTranslationRoomPage : Click "Back to room join"
  WorkspaceHomePage --> RoomsPage : Click "Meetings"
  WorkspaceHomePage --> HistoryPage : Click "History"
  WorkspaceHomePage --> DocumentsPage : Click "Documents"
  RoomsPage --> JoinTranslationRoomPage : Click "Join via code"
  RoomsPage --> RoomInformationPage : Click Meeting Row
  RoomInformationPage --> WaitingRoomPage : Click "Enter waiting room"
  RoomInformationPage --> LiveMeetingPage : Click "Join meeting"
  WaitingRoomPage --> LiveMeetingPage : Host starts meeting
  DocumentsPage --> DocumentDetailsPage : Click Document Row
}

package "Workspace Owner Or Admin" {
  rectangle "Workspace Selection Page" as OwnerWorkspaceSelectionPage
  rectangle "Workspace Creation Page" as WorkspaceCreationPage
  rectangle "Workspace Home Page" as OwnerWorkspaceHomePage
  rectangle "Members Page" as MembersPage
  rectangle "Billing Page" as BillingPage
  rectangle "Payment Plans Page" as PaymentPlansPage
  rectangle "Dashboard Page" as DashboardPage
  rectangle "Settings Page" as SettingsPage

  OwnerWorkspaceSelectionPage --> WorkspaceCreationPage : Click "Create workspace"
  WorkspaceCreationPage --> OwnerWorkspaceHomePage : Click "Create Workspace"
  OwnerWorkspaceHomePage --> MembersPage : Click "Members"
  OwnerWorkspaceHomePage --> BillingPage : Click "Billing"
  OwnerWorkspaceHomePage --> DashboardPage : Click "Dashboard"
  OwnerWorkspaceHomePage --> SettingsPage : Click "Settings"
  BillingPage --> PaymentPlansPage : Click "Manage Plan & Credits"
}

package "Platform Admin" {
  rectangle "Admin Overview Page" as AdminOverviewPage
  rectangle "Admin Workspaces Page" as AdminWorkspacesPage
  rectangle "Admin Billing Page" as AdminBillingPage
  rectangle "Admin Global Glossary Page" as AdminGlobalGlossaryPage
  rectangle "Admin Workspace Detail Page" as AdminWorkspaceDetailPage

  AdminOverviewPage --> AdminWorkspacesPage : Click "Workspaces"
  AdminOverviewPage --> AdminBillingPage : Click "Billing"
  AdminOverviewPage --> AdminGlobalGlossaryPage : Click "Global Glossary"
  AdminWorkspacesPage --> AdminWorkspaceDetailPage : Click Workspace Row
  AdminWorkspaceDetailPage --> AdminWorkspacesPage : Click "Back to directory"
}

@enduml

@startuml
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam dpi 136
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
left to right direction

package "Guest Or Invited User" {
  rectangle "Landing Page" as LandingPage
  rectangle "Login Page" as LoginPage
  rectangle "Register Page" as RegisterPage
  rectangle "Forgot Password Page" as ForgotPasswordPage
  rectangle "Verify Email Page" as VerifyEmailPage
  rectangle "Workspace Invitation Page" as WorkspaceInvitationPage
  rectangle "Workspace Selection Page" as GuestWorkspaceSelectionPage

  LandingPage --> LoginPage
  LandingPage --> RegisterPage
  LoginPage --> ForgotPasswordPage
  LoginPage --> RegisterPage
  RegisterPage --> LoginPage
  VerifyEmailPage --> LoginPage
  WorkspaceInvitationPage --> RegisterPage
  WorkspaceInvitationPage --> GuestWorkspaceSelectionPage
}

package "Workspace Member" {
  rectangle "Workspace Selection Page" as MemberWorkspaceSelectionPage
  rectangle "Workspace Join Request Page" as WorkspaceJoinRequestPage
  rectangle "Workspace Home Page" as WorkspaceHomePage
  rectangle "Rooms Page" as RoomsPage
  rectangle "Schedules Page" as SchedulesPage
  rectangle "Join Translation Room Page" as JoinTranslationRoomPage
  rectangle "Room Information Page" as RoomInformationPage
  rectangle "Waiting Room Page" as WaitingRoomPage
  rectangle "Live Meeting Page" as LiveMeetingPage
  rectangle "Room Ended Summary Page" as RoomEndedSummaryPage
  rectangle "Room Artifacts Page" as RoomArtifactsPage
  rectangle "History Page" as HistoryPage
  rectangle "Documents Page" as DocumentsPage
  rectangle "Document Details Page" as DocumentDetailsPage

  MemberWorkspaceSelectionPage --> WorkspaceHomePage
  MemberWorkspaceSelectionPage --> WorkspaceJoinRequestPage
  WorkspaceJoinRequestPage --> JoinTranslationRoomPage
  WorkspaceHomePage --> RoomsPage
  WorkspaceHomePage --> SchedulesPage
  WorkspaceHomePage --> HistoryPage
  WorkspaceHomePage --> DocumentsPage
  RoomsPage --> JoinTranslationRoomPage
  RoomsPage --> RoomInformationPage
  SchedulesPage --> RoomInformationPage
  RoomInformationPage --> WaitingRoomPage
  RoomInformationPage --> LiveMeetingPage
  WaitingRoomPage --> LiveMeetingPage
  LiveMeetingPage --> RoomEndedSummaryPage
  RoomEndedSummaryPage --> RoomArtifactsPage
  RoomEndedSummaryPage --> HistoryPage
  DocumentsPage --> DocumentDetailsPage
}

package "Workspace Owner Or Admin" {
  rectangle "Workspace Selection Page" as OwnerWorkspaceSelectionPage
  rectangle "Workspace Creation Page" as WorkspaceCreationPage
  rectangle "Workspace Home Page" as OwnerWorkspaceHomePage
  rectangle "Schedules Page" as OwnerSchedulesPage
  rectangle "Members Page" as MembersPage
  rectangle "Billing Page" as BillingPage
  rectangle "Plans Page" as PaymentPlansPage
  rectangle "Workspace Dashboard Page" as DashboardPage
  rectangle "Workspace Settings Page" as SettingsPage

  OwnerWorkspaceSelectionPage --> WorkspaceCreationPage
  WorkspaceCreationPage --> OwnerWorkspaceHomePage
  OwnerWorkspaceHomePage --> OwnerSchedulesPage
  OwnerWorkspaceHomePage --> MembersPage
  OwnerWorkspaceHomePage --> DashboardPage
  OwnerWorkspaceHomePage --> SettingsPage
  SettingsPage --> BillingPage
  BillingPage --> PaymentPlansPage
}

package "Platform Admin" {
  rectangle "Admin Overview Page" as AdminOverviewPage
  rectangle "Admin Workspaces Page" as AdminWorkspacesPage
  rectangle "Admin Billing Page" as AdminBillingPage
  rectangle "Admin Global Glossary Page" as AdminGlobalGlossaryPage
  rectangle "Admin Workspace Detail Page" as AdminWorkspaceDetailPage

  AdminOverviewPage --> AdminWorkspacesPage
  AdminOverviewPage --> AdminBillingPage
  AdminOverviewPage --> AdminGlobalGlossaryPage
  AdminWorkspacesPage --> AdminWorkspaceDetailPage
  AdminWorkspaceDetailPage --> AdminWorkspacesPage
}

@enduml

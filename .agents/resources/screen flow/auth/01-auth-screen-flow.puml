@startuml
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
left to right direction

' Pages
rectangle "Landing Page" as LandingPage
rectangle "Login Page" as LoginPage
rectangle "Register Page" as RegisterPage
rectangle "Forgot Password Page" as ForgotPasswordPage
rectangle "Reset Password Page" as ResetPasswordPage
rectangle "Verify Email Page" as VerifyEmailPage
rectangle "Accept Invitation Page" as AcceptInvitationPage
rectangle "Workspace Selection Page" as WorkspaceSelectionPage

' Authentication Flow
LandingPage --> LoginPage
LandingPage --> RegisterPage

LoginPage --> RegisterPage
RegisterPage --> LoginPage

LoginPage --> ForgotPasswordPage
ForgotPasswordPage --> LoginPage
ForgotPasswordPage --> ResetPasswordPage
ResetPasswordPage --> LoginPage

RegisterPage --> VerifyEmailPage
VerifyEmailPage --> LoginPage

' Login Success Redirection
LoginPage --> WorkspaceSelectionPage

' Invite Acceptance Flow
AcceptInvitationPage --> LoginPage
LoginPage --> WorkspaceSelectionPage

@enduml

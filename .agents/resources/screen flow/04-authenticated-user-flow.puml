@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
left to right direction

rectangle "Workspace Selection Page" as WorkspaceSelectionPage
rectangle "Workspace Creation Page" as WorkspaceCreationPage
rectangle "Workspace Join Request Page" as WorkspaceJoinRequestPage
rectangle "Workspace Home Page" as WorkspaceHomePage
rectangle "Join Translation Room Page" as JoinTranslationRoomPage
rectangle "Account Preferences Page" as AccountPreferencesPage
rectangle "Account Profile Page" as AccountProfilePage
rectangle "Voice Profiles Page" as VoiceProfilesPage

WorkspaceSelectionPage --> WorkspaceHomePage
WorkspaceSelectionPage --> WorkspaceCreationPage
WorkspaceSelectionPage --> WorkspaceJoinRequestPage

WorkspaceCreationPage --> WorkspaceHomePage
WorkspaceJoinRequestPage --> JoinTranslationRoomPage

WorkspaceHomePage --> AccountPreferencesPage
WorkspaceHomePage --> AccountProfilePage
WorkspaceHomePage --> VoiceProfilesPage

@enduml

@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
left to right direction

' Screen Nodes & Modals
rectangle "Workspace Home Page" as WorkspaceHome
rectangle "Workspace Documents Page" as DocumentsPage
rectangle "Document View & Chunks Page" as DocumentViewPage
rectangle "Upload Document Modal" as UploadDocumentModal

' Workspace Documents Management Flow
WorkspaceHome --> DocumentsPage
DocumentsPage --> UploadDocumentModal
UploadDocumentModal --> DocumentsPage
DocumentsPage --> DocumentViewPage
DocumentViewPage --> DocumentsPage

@enduml

@startuml
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
left to right direction

rectangle "Current Workspace Home Page" as CurrentWorkspaceHome
rectangle "Workspace Selector Dropdown" as WorkspaceDropdown
rectangle "Target Workspace Home Page" as TargetWorkspaceHome
rectangle "Create Workspace Page" as CreateWorkspacePage
rectangle "Workspace Selection Page" as WorkspaceSelectionPage

' Switch Workspace Flow via Dropdown
CurrentWorkspaceHome --> WorkspaceDropdown
WorkspaceDropdown --> TargetWorkspaceHome

' Secondary Actions from Dropdown
WorkspaceDropdown --> CreateWorkspacePage
CreateWorkspacePage --> TargetWorkspaceHome

WorkspaceDropdown --> WorkspaceSelectionPage
WorkspaceSelectionPage --> TargetWorkspaceHome

@enduml

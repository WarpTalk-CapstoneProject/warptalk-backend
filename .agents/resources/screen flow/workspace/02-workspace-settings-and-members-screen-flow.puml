@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
left to right direction

rectangle "Workspace Home Page" as WorkspaceHome
rectangle "Workspace Settings Page" as WorkspaceSettingsPage
rectangle "Manage Access Page" as ManageAccessPage
rectangle "Invite Member Modal" as InviteMemberModal
rectangle "Workspace Selection Page" as WorkspaceSelectionPage

WorkspaceHome --> WorkspaceSettingsPage
WorkspaceHome --> ManageAccessPage
ManageAccessPage --> InviteMemberModal
InviteMemberModal --> ManageAccessPage
WorkspaceSettingsPage --> WorkspaceSelectionPage

@enduml

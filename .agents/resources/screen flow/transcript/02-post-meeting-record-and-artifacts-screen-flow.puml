@startuml
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
left to right direction

rectangle "Active Meeting Room Page" as ActiveMeetingRoomPage
rectangle "Room Ended Summary Page" as RoomEndedSummaryPage
rectangle "Room Artifacts Page" as RoomArtifactsPage
rectangle "History Page" as HistoryPage
rectangle "Schedules Page" as SchedulesPage
rectangle "Room Information Page" as RoomInformationPage
rectangle "Meeting Transcript Tab" as MeetingTranscriptTab
rectangle "Meeting Summary Tab" as MeetingSummaryTab
rectangle "Meeting Artifacts Tab" as MeetingArtifactsTab

ActiveMeetingRoomPage --> RoomEndedSummaryPage
RoomEndedSummaryPage --> RoomArtifactsPage
RoomEndedSummaryPage --> HistoryPage

HistoryPage --> RoomInformationPage
SchedulesPage --> RoomInformationPage
RoomInformationPage --> MeetingTranscriptTab
RoomInformationPage --> MeetingSummaryTab
RoomInformationPage --> MeetingArtifactsTab

@enduml

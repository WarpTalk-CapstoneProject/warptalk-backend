{
  "ConnectionStrings": {
    "AssistantDb": "Host=localhost;Port=5432;Database=warptalk;Username=postgres;Password=postgres;Search Path=assistant,public"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Jwt": {
    "SecretKey": "CHANGE_ME_SUPER_SECRET_KEY_MIN_32_CHARS_LONG!!",
    "Issuer": "WarpTalk.AuthService",
    "Audience": "WarpTalk"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:5108",
      "http://127.0.0.1:5108"
    ]
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "GrpcSettings": {
    "WorkspaceServiceUrl": "http://localhost:50056"
  },
  "Plugins": {
    "GoogleWorkspace": {
      "OAuth": {
        "ClientId": "",
        "ClientSecret": "",
        "RedirectUri": "http://localhost:5108/api/v1/assistant/plugins/google_workspace/oauth/callback",
        "AuthorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
        "TokenEndpoint": "https://oauth2.googleapis.com/token",
        "UserInfoEndpoint": "https://openidconnect.googleapis.com/v1/userinfo"
      },
      "Api": {
        "DriveFilesEndpoint": "https://www.googleapis.com/drive/v3/files",
        "CalendarEventsEndpointFormat": "https://www.googleapis.com/calendar/v3/calendars/{0}/events"
      }
    }
  }
}

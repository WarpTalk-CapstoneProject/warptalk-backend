          "required": [
            "translation_room_id",
            "workspace_id"
          ],
          "properties": {
            "translation_room_id": {
              "type": "string",
              "format": "uuid"
            },
            "workspace_id": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    }

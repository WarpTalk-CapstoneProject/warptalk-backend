{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.warptalk.vn/events/v1/meeting-started.schema.json",
  "title": "Meeting started v1",
  "x-schema-version": 1,
  "x-event-types": [
    "meeting.started"
  ],

{
  "ConnectionStrings": {
    "BillingDb": "Host=localhost;Port=5432;Database=warptalk;Username=postgres;Password=postgres;Search Path=subscription,public",
    "Redis": "localhost:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Jwt": {
    "SecretKey": "CHANGE_ME_SUPER_SECRET_KEY_MIN_32_CHARS_LONG!!",
    "Issuer": "WarpTalk.AuthService",
    "Audience": "WarpTalk",
    "ExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:5201",
      "http://127.0.0.1:5201"
    ]
  },
  "Auth": {
    "GrpcEndpoint": "http://localhost:50051"
  },
  "Billing": {
    "Workers": {
      "SessionMonitorIntervalSeconds": 5,
      "StaleReservationIntervalMinutes": 5,
      "SubscriptionExpirationIntervalMinutes": 60,
      "SubscriptionRenewalIntervalMinutes": 60,
      "SubscriptionRenewalWindowHours": 24,
      "SubscriptionRenewalLookbackHours": 24,
      "DailyAuditHourUtc": 0,
      "BillingAggregationIntervalMinutes": 5,
      "BillingAggregationBatchSize": 1000,
      "BillingCycleIntervalMinutes": 60,
      "InvoiceOverdueIntervalMinutes": 60
    }
  }
}

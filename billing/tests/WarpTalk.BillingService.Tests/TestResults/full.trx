    trial_ends_at timestamp with time zone,
    credits_per_cycle_override integer,
    contract_price_usd numeric(14,2),
    overage_cap_credits_override integer,
    overage_price_per_credit_override numeric(18,10),
    invoice_terms_days_override integer,
    entitlement_overrides jsonb,
    billing_contact_email character varying(255),
    overage_credits_this_cycle integer NOT NULL DEFAULT 0,
    overage_started_at timestamp with time zone,
    service_state character varying(20) NOT NULL DEFAULT 'healthy',
    suspended_reason character varying(30),
    owner_email_domain character varying(255),
    is_active boolean NOT NULL DEFAULT TRUE,
    frozen_credits integer NOT NULL DEFAULT 0,
    credits_frozen_at timestamp with time zone,
    frozen_credits_dormant_at timestamp with time zone,
    renewal_mode character varying(16) NOT NULL DEFAULT 'invoice',
    stripe_subscription_id character varying(255),
    stripe_customer_id character varying(255),
    stripe_subscription_status character varying(32),
    payment_failed_at timestamp with time zone,

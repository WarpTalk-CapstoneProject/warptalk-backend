CREATE TABLE subscription.subscriptions (
    id uuid NOT NULL DEFAULT (uuidv7()),
    user_id uuid NOT NULL,
    workspace_id uuid NOT NULL,
    plan_id uuid NOT NULL,
    status character varying(20) NOT NULL DEFAULT 'active',
    credits_remaining integer NOT NULL DEFAULT 0,
    credits_used_this_cycle integer NOT NULL DEFAULT 0,
    current_period_start timestamp with time zone NOT NULL,
    current_period_end timestamp with time zone NOT NULL,
    auto_renew boolean NOT NULL DEFAULT TRUE,
    cancellation_reason text,
    cancelled_at timestamp with time zone,
    trial_ends_at timestamp with time zone,
    credits_per_cycle_override integer,
    contract_price_usd numeric(14,2),
    overage_cap_credits_override integer,
    overage_price_per_credit_override numeric(18,10),
    invoice_terms_days_override integer,
    entitlement_overrides jsonb,
    billing_contact_email character varying(255),
    overage_credits_this_cycle integer NOT NULL DEFAULT 0,
    overage_started_at timestamp with time zone,
    service_state character varying(20) NOT NULL DEFAULT 'healthy',
    suspended_reason character varying(30),
    owner_email_domain character varying(255),
    is_active boolean NOT NULL DEFAULT TRUE,
    frozen_credits integer NOT NULL DEFAULT 0,
    credits_frozen_at timestamp with time zone,
    frozen_credits_dormant_at timestamp with time zone,
    renewal_mode character varying(16) NOT NULL DEFAULT 'invoice',
    stripe_subscription_id character varying(255),
    stripe_customer_id character varying(255),
    stripe_subscription_status character varying(32),
    payment_failed_at timestamp with time zone,
    payment_grace_ends_at timestamp with time zone,
    payment_failure_reason character varying(500),
    created_at timestamp with time zone NOT NULL DEFAULT (now()),
    created_by uuid,
    updated_at timestamp with time zone NOT NULL DEFAULT (now()),
    updated_by uuid,
    deleted_at timestamp with time zone,
    deleted_by uuid,
    CONSTRAINT subscriptions_pkey PRIMARY KEY (id),
    CONSTRAINT chk_subscription_credits CHECK (credits_remaining &gt;= -2147483648),
    CONSTRAINT chk_subscription_status CHECK (status IN ('pending', 'active', 'cancelled', 'expired')),
    CONSTRAINT chk_subscriptions_renewal_mode CHECK (renewal_mode IN ('invoice', 'stripe', 'none')),
    CONSTRAINT subscriptions_plan_id_fkey FOREIGN KEY (plan_id) REFERENCES subscription.plans (id)
);

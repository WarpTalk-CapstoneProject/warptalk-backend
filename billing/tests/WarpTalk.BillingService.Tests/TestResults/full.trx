CREATE TABLE subscription.addons (
    id uuid NOT NULL DEFAULT (uuidv7()),
    slug character varying(60) NOT NULL,
    name character varying(100) NOT NULL,
    description character varying(500),
    unit_label character varying(40) NOT NULL,
    entitlement_key character varying(50) NOT NULL,
    units_per_quantity integer NOT NULL,
    price_monthly_vnd numeric(14,0),
    price_yearly_vnd numeric(14,0),
    price_monthly_usd numeric(12,2),
    price_yearly_usd numeric(12,2),
    min_quantity integer NOT NULL,
    max_quantity integer NOT NULL,

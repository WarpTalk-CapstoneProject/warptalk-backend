CREATE TABLE subscription.sales_inquiries (
    id uuid NOT NULL DEFAULT (uuidv7()),
    first_name character varying(80) NOT NULL,
    last_name character varying(80) NOT NULL,
    work_email character varying(255) NOT NULL,
    company character varying(160) NOT NULL,
    request_type character varying(80) NOT NULL,
    feature_interests jsonb NOT NULL DEFAULT ('[]'::jsonb),
    target_languages jsonb NOT NULL DEFAULT ('[]'::jsonb),
    current_monthly_meeting_volume character varying(80) NOT NULL,
    expected_monthly_meeting_volume_in_six_months character varying(80),
    use_case_notes text,
    pricing_estimate_json jsonb NOT NULL DEFAULT ('{}'::jsonb),
    consent boolean NOT NULL,
    source character varying(80) NOT NULL DEFAULT 'landing_pricing',
    status character varying(30) NOT NULL DEFAULT 'new',
    workspace_id uuid,
    subscription_id uuid,
    created_at timestamp with time zone NOT NULL DEFAULT (now()),
    updated_at timestamp with time zone NOT NULL DEFAULT (now()),
    converted_at timestamp with time zone,
    closed_at timestamp with time zone,
    CONSTRAINT sales_inquiries_pkey PRIMARY KEY (id),
    CONSTRAINT sales_inquiries_status_chk CHECK (status IN ('new', 'reviewing', 'quoted', 'converted', 'closed'))
);
COMMENT ON COLUMN subscription.sales_inquiries.workspace_id IS 'External WorkspaceService workspace id. No physical FK.';
COMMENT ON COLUMN subscription.sales_inquiries.subscription_id IS 'External subscription id captured after conversion. No physical FK to keep inquiry archival.';

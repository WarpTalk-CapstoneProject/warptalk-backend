CREATE TABLE subscription.usage_records (
    id uuid NOT NULL DEFAULT (uuidv7()),
    subscription_id uuid NOT NULL,
    user_id uuid,
    workspace_id uuid NOT NULL,
    translation_room_id uuid,
    segment_id uuid,
    usage_type character varying(30) NOT NULL,
    unit character varying(20) NOT NULL DEFAULT 'credit',
    quantity numeric(12,4) NOT NULL DEFAULT 1.0,
    credits_consumed integer NOT NULL,
    duration_seconds integer,
    details jsonb,
    recorded_at timestamp with time zone NOT NULL DEFAULT (now()),
    CONSTRAINT usage_records_pkey PRIMARY KEY (id),
    CONSTRAINT usage_records_subscription_id_fkey FOREIGN KEY (subscription_id) REFERENCES subscription.subscriptions (id)
);
COMMENT ON COLUMN subscription.usage_records.user_id IS 'External AuthService user id. No physical FK.';

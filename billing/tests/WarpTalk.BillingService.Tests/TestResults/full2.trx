SELECT count(*)::int
FROM subscription.credit_transactions AS c
INNER JOIN (
    SELECT s.id, s.deleted_at
    FROM subscription.subscriptions AS s
    WHERE s.deleted_at IS NULL
) AS s0 ON c.subscription_id = s0.id
WHERE s0.deleted_at IS NULL AND c.subscription_id = @sub_Id

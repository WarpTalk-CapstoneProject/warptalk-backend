SELECT p.id, p.ai_assistant_enabled, p.billing_cycle, p.created_at, p.created_by, p.credits_per_cycle, p.currency, p.dedicated_gpu, p.deleted_at, p.deleted_by, p.features, p.glossary_enabled, p.invoice_grace_hours, p.invoice_terms_days, p.is_active, p.low_balance_threshold_credits, p.max_active_rooms, p.max_languages, p.max_participants, p.name, p.overage_cap_credits, p.overage_price_per_credit, p.price, p.rollover_cap_credits, p.slug, p.sort_order, p.stripe_price_ids, p.stripe_product_id, p.tier, p.updated_at, p.updated_by, p.voice_clone_enabled
FROM subscription.plans AS p
WHERE p.deleted_at IS NULL AND p.id = @planId
LIMIT 2

VALUES (@p0, @p1, @p2, @p3, @p4, @p5, @p6, @p7, @p8, @p9, @p10, @p11, @p12, @p13, @p14, @p15, @p16, @p17, @p18, @p19, @p20)
RETURNING ai_assistant_enabled, created_at, dedicated_gpu, glossary_enabled, is_active, low_balance_threshold_credits, overage_cap_credits, rollover_cap_credits, sort_order, updated_at, voice_clone_enabled;

CREATE TABLE subscription.addons (
    id uuid NOT NULL DEFAULT (uuidv7()),
    slug character varying(60) NOT NULL,
    name character varying(100) NOT NULL,
    description character varying(500),
    unit_label character varying(40) NOT NULL,
    entitlement_key character varying(50) NOT NULL,
    units_per_quantity integer NOT NULL,
    price_monthly_vnd numeric(14,0),
    price_yearly_vnd numeric(14,0),
    price_monthly_usd numeric(12,2),
    price_yearly_usd numeric(12,2),
    min_quantity integer NOT NULL,
    max_quantity integer NOT NULL,
    eligible_plan_ids uuid[] NOT NULL,
    status character varying(20) NOT NULL,
    sort_order integer NOT NULL,
    stripe_product_id character varying(255),
    stripe_price_ids jsonb NOT NULL,
    stripe_synced_at timestamp with time zone,
    stripe_sync_error character varying(500),
    stripe_synced_hash character varying(64),
    created_at timestamp with time zone NOT NULL,
    created_by uuid,
    updated_at timestamp with time zone NOT NULL,
    updated_by uuid,
    archived_at timestamp with time zone,
    CONSTRAINT addons_pkey PRIMARY KEY (id)
);
